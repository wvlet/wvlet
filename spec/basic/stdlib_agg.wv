-- Standard library aggregation functions over grouped columns
from [
  [1, true, 'x', 1.0],
  [1, false, 'y', 3.0],
] as t(id, b, s, vv)
select id, b, s, vv.to_double as v
group by id
agg
  b.bool_and as ba,
  b.bool_or as bo,
  s.string_agg('-') as sa,
  s.count_approx_distinct as ndv,
  v.median as med,
  v.stddev_pop as sp,
  v.var_samp as vs,

test _.size should be 1
test _.rows should be [[
  1,
  false,
  true,
  'x-y',
  2,
  2.0,
  1.0,
  2.0,
]]
