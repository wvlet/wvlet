-- Higher-order array functions taking a lambda, in method-call form
select [4, 5, 6] as a
select
  -- Array results are joined to strings so the expected value is engine-independent
  a.transform(x -> x * 2).mk_string(',') as doubled,
  a.filter(x -> x > 4).mk_string(',') as large,
  a.reduce((acc, x) -> acc + x) as total,
  a.transform(x -> x + 1).filter(x -> x % 2 = 0).mk_string(',') as chained,
  a.transform(x -> [1, 2].reduce((p, q) -> p + q) + x).mk_string(',') as nested,
  [7].reduce((acc, x) -> acc * x) as single
test _.rows should be [['8,10,12', '5,6', 15, '6', '7,8,9', 7]]
;

-- Lambdas over array columns, one array per row
from [[1, [1, 2], ['a', 'bb']], [2, [3, 4, 5], ['ccc']]] as lists(id, nums, words)
select
  id,
  nums.transform(n -> n * 10).mk_string(',') as tens,
  nums.reduce((acc, n) -> acc + n) as total,
  words.filter(w -> w.length > 1).mk_string(',') as long_words
order by id
test _.rows should be [[1, '10,20', 3, 'bb'], [2, '30,40,50', 12, 'ccc']]
;

-- Predicates and folds with an initial value
select [1, 5, 9] as a
select
  a.exists(x -> x > 8) as some_large,
  a.exists(x -> x > 9) as none_large,
  a.forall(x -> x > 0) as all_positive,
  a.forall(x -> x > 1) as not_all,
  a.reduce(10, (acc, x) -> acc + x) as from_ten,
  a.reduce('', (acc, x) -> acc + x.to_string) as digits,
  -- An empty array: exists is false, forall is true, and reduce gives the initial value
  a.filter(x -> x > 9).exists(x -> x > 0) as empty_exists,
  a.filter(x -> x > 9).forall(x -> x > 0) as empty_forall,
  a.filter(x -> x > 9).reduce(0, (acc, x) -> acc + x) as empty_sum,
  -- NULL elements: a true or false result wins over NULL, as SQL or / and
  [1, null].exists(x -> x > 0) as null_exists_true,
  [1, null].exists(x -> x > 5) is null as null_exists_unknown,
  [1, null].forall(x -> x > 5) as null_forall_false,
  [1, null].forall(x -> x > 0) is null as null_forall_unknown
test _.rows should be [[true, false, true, false, 25, '159', false, true, 0, true, true, false, true]]
;

-- zip_with combines the elements at the same position; the shorter array is padded with NULL
select
  [1, 2].zip_with([10, 20], (x, y) -> x + y).mk_string(',') as sums,
  [1, 2, 3].zip_with([10, 20], (x, y) -> x + coalesce(y, 0)).mk_string(',') as padded,
  ['a', 'b'].zip_with([1, 2], (s, n) -> s + n.to_string).mk_string(',') as labels,
  -- The inner x is the inner lambda's own parameter
  [1, 2].zip_with([3, 4], (x, y) -> [x].transform(x -> x * 10).mk_string('') + '-' + y.to_string).mk_string(',') as shadowed
test _.rows should be [['11,22', '11,22,3', 'a1,b2', '10-3,20-4']]
;

-- Prices in cents
from [[1, [250, 400], [2, 3]], [2, [100], [5]]] as orders(id, prices, quantities)
select
  id,
  prices.zip_with(quantities, (p, q) -> p * q).reduce(0, (acc, v) -> acc + v) as total
order by id
test _.rows should be [[1, 1700], [2, 500]]
;
