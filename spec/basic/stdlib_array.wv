-- Standard library array functions
select [3, 1, 2, 2] as a
select
  a.size as sz,
  a.get(1) as first,
  a.contains(2) as has,
  a.index_of(2) as idx,
  a.sort as sorted,
  a.distinct.sort as dist,
  a.reverse as rev,
  a.concat([9]) as cc,
  a.mk_string('-') as st,

test _.size should be 1
test _.rows should be [[
  4,
  3,
  true,
  3,
  [1, 2, 2, 3],
  [1, 2, 3],
  [2, 2, 1, 3],
  [3, 1, 2, 2, 9],
  '3-1-2-2',
]]
