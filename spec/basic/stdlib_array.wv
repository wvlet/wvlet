-- Standard library array functions
select [3, 1, 2, 2] as a
select
  a.size as sz,
  a.get(1) as first,
  a.contains(2) as has,
  a.index_of(2) as idx,
  -- Array results are joined to strings so the expected value is engine-independent
  a.sort.mk_string(',') as sorted,
  a.distinct.sort.mk_string(',') as dist,
  a.reverse.mk_string(',') as rev,
  a.concat([9]).mk_string(',') as cc,
  a.mk_string('-') as st,

test _.size should be 1
test _.rows should be [[
  4,
  3,
  true,
  3,
  '1,2,2,3',
  '1,2,3',
  '2,2,1,3',
  '3,1,2,2,9',
  '3-1-2-2',
]]
