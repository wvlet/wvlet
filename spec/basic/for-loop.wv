-- Repeat statements over an array literal
for i in [1, 2, 3] {
  select i * 10 as v
  test _.size should be 1
}

-- The loop variable is usable in table-name interpolation
for name in ['a', 'b'] {
  from [[1, name]] as t(id, label)
  save to s`for_loop_tbl_${name}`
}

from for_loop_tbl_a
test _.rows should be [[1, 'a']]

from for_loop_tbl_b
test _.rows should be [[1, 'b']]

-- Iterate over a val holding an array
val for_loop_ids = [10, 20]

for id in for_loop_ids {
  from [[id, 'val']] as t(id, src)
  append to for_loop_acc
}

-- Iterate over the first column of a query result
for id in (from [[30], [40]] as t(id) select id order by id) {
  from [[id, 'query']] as t(id, src)
  append to for_loop_acc
}

from for_loop_acc
order by id
test _.rows should be [[10, 'val'], [20, 'val'], [30, 'query'], [40, 'query']]

-- Nested loops and body-local vals
for x in [1, 2] {
  for y in [3, 4] {
    val sum = 0
    from [[x, y]] as t(x, y)
    append to for_loop_pairs
  }
}

from for_loop_pairs
order by x, y
test _.rows should be [[1, 3], [1, 4], [2, 3], [2, 4]]

-- An empty iterable runs nothing
for e in [] {
  from for_loop_missing_table
}

-- The loop variable shadows a same-named outer val, and a nested loop variable shadows the
-- enclosing one
val for_loop_label = 'outer'

for for_loop_label in ['a', 'b'] {
  for for_loop_label in ['x'] {
    from [[for_loop_label]] as t(label)
    append to for_loop_shadow
  }
  from [[for_loop_label]] as t(label)
  append to for_loop_shadow
}

from [[for_loop_label]] as t(label)
append to for_loop_shadow

from for_loop_shadow
test _.rows should be [['x'], ['a'], ['x'], ['b'], ['outer']]

-- A query iterable is not cut off by the display row limit
for n in (from sql"select range as n from range(100)") {
  from [[n]] as t(n)
  append to for_loop_many
}

from for_loop_many
agg _.count as cnt
test _.rows should be [[100]]
