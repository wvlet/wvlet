-- Engine conformance cases (compared against DuckDB by EngineBasicSpecTest)
-- unnest next to `*`: every input column is kept
from [[1, 'a', [10, 20]], [2, 'b', [30]]] as t(id, name, xs)
select *, unnest(xs) as x
order by id, x

-- LEFT JOIN unnest keeps rows whose list is empty or NULL
from [[1, [1, 2]], [2, []], [3, null]] as u(id, xs)
left join unnest(xs) as v(x) on true
select id, x
order by id, x

-- A lateral unnest inside a larger join tree
from [[1, [10, 20]], [2, [30]]] as t(id, xs)
cross join unnest(xs) as u(x)
join [[1, 'one'], [2, 'two']] as s(sid, label) on s.sid = t.id
select id, x, label
order by id, x
