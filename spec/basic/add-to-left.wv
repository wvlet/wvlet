from 'person.json'
add to left 1 as index
test _.columns should be ['index', 'id', 'name', 'age']


from 'person.json'
add to left
  1 as index,
  'a' as v,
test _.columns should be ['index', 'v', 'id', 'name', 'age']


from 'person.json'
add to right 1 as index
test _.columns should be ['id', 'name', 'age', 'index']
