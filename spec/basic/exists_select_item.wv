-- EXISTS and NOT EXISTS as select-item expressions
from [[1, 10], [2, null], [null, 30]] as l(a, b)
select
  a,
  exists { from [[1], [3]] as r(c) where r.c = l.a } as e,
  not exists { from [[1], [3]] as r(c) where r.c = l.a } as ne
order by a nulls last
test _.output should be """
┌─────┬─────────┬─────────┐
│  a  │    e    │   ne    │
│ int │ boolean │ boolean │
├─────┼─────────┼─────────┤
│   1 │ true    │ false   │
│   2 │ false   │ true    │
│     │ false   │ true    │
├─────┴─────────┴─────────┤
│ 3 rows                  │
└─────────────────────────┘
"""
;

-- An uncorrelated EXISTS
from [[1], [2]] as l(a)
select a, exists { from [[1]] as r(c) where r.c > 5 } as e
order by a
test _.columns should be ['a', 'e']
