-- Standard library date and timestamp functions
from [['2024-03-15', '2024-03-15 10:30:45']] as t(ds, ts)
select
  ds.to_date as d,
  ts.to_timestamp as tt,
select
  d.year as y,
  d.month as mo,
  d.day as dy,
  d.quarter as q,
  d.day_of_week as dow,
  d.day_of_year as doy,
  d.truncate_to('month') as tm,
  d.add_days(10) as ad,
  d.add_months(1) as am,
  d.diff_days('2024-03-25'.to_date) as dd,
  d.last_day as ld,
  d.format('%Y/%m/%d') as fmt,
  tt.hour as h,
  tt.minute as mi,
  tt.second as se,
  tt.truncate_to('hour').to_string as th,
  tt.add_hours(3).to_string as ah,
  tt.diff_hours('2024-03-15 13:30:45'.to_timestamp) as dh,
  tt.to_unixtime as ut,
  tt.to_date as td,

test _.size should be 1
test _.rows should be [[
  2024,
  3,
  15,
  1,
  5,
  75,
  '2024-03-01',
  '2024-03-25',
  '2024-04-15',
  10,
  '2024-03-31',
  '2024/03/15',
  10,
  30,
  45,
  '2024-03-15 10:00:00',
  '2024-03-15 13:30:45',
  3,
  1710498645,
  '2024-03-15',
]]
