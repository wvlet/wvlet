select 'hello' + ' wvlet!'
test _.output should be """
┌────────────────────────────┐
│ concat('hello', ' wvlet!') │
│           string           │
├────────────────────────────┤
│ hello wvlet!               │
├────────────────────────────┤
│ 1 rows                     │
└────────────────────────────┘
"""
;

select 'hello' + ' "wvlet!"'
test _.output should be """
┌──────────────────────────────┐
│ concat('hello', ' "wvlet!"') │
│            string            │
├──────────────────────────────┤
│ hello "wvlet!"               │
├──────────────────────────────┤
│ 1 rows                       │
└──────────────────────────────┘
"""
;

-- need to use escape single quote
select "hello" + " 'wvlet!'"
test _.output should be """
┌────────────────────────────────┐
│ concat('hello', ' ''wvlet!''') │
│             string             │
├────────────────────────────────┤
│ hello 'wvlet!'                 │
├────────────────────────────────┤
│ 1 rows                         │
└────────────────────────────────┘
"""
;

select "hello" + " wvlet" + " and airframe!"
test _.output should be """
┌─────────────────────────────────────────────────────┐
│ concat(concat('hello', ' wvlet'), ' and airframe!') │
│                       string                        │
├─────────────────────────────────────────────────────┤
│ hello wvlet and airframe!                           │
├─────────────────────────────────────────────────────┤
│ 1 rows                                              │
└─────────────────────────────────────────────────────┘
"""
;


select "hello " + 2024
test _.output should be """
┌────────────────────────────────────────┐
│ concat('hello ', CAST(2024 AS string)) │
│                 string                 │
├────────────────────────────────────────┤
│ hello 2024                             │
├────────────────────────────────────────┤
│ 1 rows                                 │
└────────────────────────────────────────┘
"""
;

-- A string on the right side also concatenates
select 2024 + ' items'
test _.rows should be [['2024 items']]
;

-- NULL operands are skipped, on every engine
select 'hello' + null
test _.rows should be [['hello']]
;

select null + 'world'
test _.rows should be [['world']]
;
