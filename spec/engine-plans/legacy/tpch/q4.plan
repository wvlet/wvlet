-- q4#1
Scan[lineitem](columns=l_orderkey,l_commitdate,l_receiptdate) -> [l_orderkey:long, l_commitdate:date, l_receiptdate:date]
↓ Filter((#1<#2), keep=0) -> [l_orderkey:long]
  Scan[orders](columns=o_orderkey,o_orderdate,o_orderpriority) -> [o_orderkey:long, o_orderdate:date, o_orderpriority:string]
  ↓ Morsel[parallelism=N] -> [o_orderkey:long, o_orderdate:date, o_orderpriority:string]
↙ HashJoin[RightSemi](#0 = #0) -> [o_orderkey:long, o_orderdate:date, o_orderpriority:string]
↓ Filter(((#1>=lit(8582:date)) and (#1<lit(8674:date))), keep=2) -> [o_orderpriority:string]
↓ HashAgg(keys=[#0], aggs=[agg:count_star()]) -> [o_orderpriority:string, __partial_0:long]
↓ Morsel[parallelism=N] -> [o_orderpriority:string, __partial_0:long]
↓ PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:sum(#1)]) -> [o_orderpriority:string, __final_0:long]
↓ Project(#0, #1) -> [o_orderpriority:string, agg:count_star():long]
↓ Project(#0, #1) -> [o_orderpriority:string, order_count:long]
↓ Sort[parallelism=N](#0) -> [o_orderpriority:string, order_count:long]
