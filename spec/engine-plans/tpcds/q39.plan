-- q39#1
Sort[parallelism=N](#0, #1, #2, #3, #4, #7, #8, #9) -> [wsk1:long, isk1:long, dmoy1:long, mean1:double, cov1:double, w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double]
  Morsel[parallelism=N] -> [wsk1:long, isk1:long, dmoy1:long, mean1:double, cov1:double, w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double]
