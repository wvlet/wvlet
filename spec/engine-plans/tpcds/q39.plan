      HashJoin[Inner](#1,#0 = #1,#0) -> [w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double, w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double]
        Filter((#2=lit(1:long))) -> [w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double]
          Scan[CTE[inv]](columns=w_warehouse_sk,i_item_sk,d_moy,mean,cov) -> [w_warehouse_sk:long, i_item_sk:long, d_moy:long, mean:double, cov:double]
            (shared)
              Project(#0, #1, #2, #3, #4, #5, #6) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, stdev:double, mean:double, cov:double]
                Project(#0, #1, #2, #3, #4, #5, case((#5=lit(0.0:double))->lit(null:null);Some((#4/#5)))) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, stdev:double, mean:double, cov:double]
                  Filter((case((#5=lit(0.0:double))->lit(0:int);Some((#4/#5)))>lit(1.0:double))) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, stdev:double, mean:double]
                    Project(#0, #1, #2, #3, #4, #5) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, stdev:double, mean:double]
                      Project(#0, #1, #2, #3, (#4*lit(1.000:decimal(4,3))), #5) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, stdev:double, mean:double]
                        PartitionedAgg[parallelism=N](keys=[#7, #6, #8, #5], aggs=[agg:stddev_samp(#3), agg:avg(#3)]) -> [w_warehouse_name:string, w_warehouse_sk:long, i_item_sk:long, d_moy:long, agg:stddev_samp(#3):double, agg:avg(#3):double]
                          Morsel[parallelism=N] -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, d_date_sk:long, d_moy:long, w_warehouse_sk:long, w_warehouse_name:string, i_item_sk:long]
                            HashJoin[Inner](#1 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, d_date_sk:long, d_moy:long, w_warehouse_sk:long, w_warehouse_name:string, i_item_sk:long]
                              HashJoin[Inner](#2 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, d_date_sk:long, d_moy:long, w_warehouse_sk:long, w_warehouse_name:string]
                                HashJoin[Inner](#0 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, d_date_sk:long, d_moy:long]
                                  Scan[inventory]() -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int]
                                  Morsel[parallelism=N] -> [d_date_sk:long, d_moy:long]
                                    Filter((#1=lit(2001:long)), keep=0,2) -> [d_date_sk:long, d_moy:long]
                                      Scan[date_dim](columns=d_date_sk,d_year,d_moy filter=Compare(d_year,Eq,2001)) -> [d_date_sk:long, d_year:long, d_moy:long]
                                Morsel[parallelism=N] -> [w_warehouse_sk:long, w_warehouse_name:string]
