  Project(#0, #1, #2, #3) -> [w_warehouse_name:string, i_item_id:string, inv_before:long, inv_after:long]
    Filter(((case((#2>lit(0:long))->((#3*lit(1.000:decimal(4,3)))/#2);Some(lit(null:null)))>=(lit(2.000:decimal(4,3))/lit(3.000:decimal(4,3)))) and (case((#2>lit(0:long))->((#3*lit(1.000:decimal(4,3)))/#2);Some(lit(null:null)))<=(lit(3.000:decimal(4,3))/lit(2.000:decimal(4,3)))))) -> [w_warehouse_name:string, i_item_id:string, inv_before:long, inv_after:long]
      Project(#0, #1, #2, #3) -> [w_warehouse_name:string, i_item_id:string, inv_before:long, inv_after:long]
        Project(#0, #1, #2, #3) -> [w_warehouse_name:string, i_item_id:string, inv_before:long, inv_after:long]
          Project(#0, #1, #2, #3) -> [w_warehouse_name:string, i_item_id:string, agg:sum(case((#42<lit(11027:date))->#3;Some(lit(0:int)))):long, agg:sum(case((#42>=lit(11027:date))->#3;Some(lit(0:int)))):long]
            PartitionedAgg[parallelism=N](keys=[#0, #1], aggs=[agg:sum(#2), agg:sum(#3)]) -> [w_warehouse_name:string, i_item_id:string, __final_0:long, __final_1:long]
              Morsel[parallelism=N] -> [w_warehouse_name:string, i_item_id:string, __partial_0:long, __partial_1:long]
                HashAgg(keys=[#7, #5], aggs=[agg:sum(case((#9<lit(11027:date))->#3;Some(lit(0:int)))), agg:sum(case((#9>=lit(11027:date))->#3;Some(lit(0:int))))]) -> [w_warehouse_name:string, i_item_id:string, __partial_0:long, __partial_1:long]
                  HashJoin[Inner](#0 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, i_item_sk:long, i_item_id:string, w_warehouse_sk:long, w_warehouse_name:string, d_date_sk:long, d_date:date]
                    HashJoin[Inner](#2 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, i_item_sk:long, i_item_id:string, w_warehouse_sk:long, w_warehouse_name:string]
                      HashJoin[Inner](#1 = #0) -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int, i_item_sk:long, i_item_id:string]
                        Scan[inventory]() -> [inv_date_sk:long, inv_item_sk:long, inv_warehouse_sk:long, inv_quantity_on_hand:int]
                        Morsel[parallelism=N] -> [i_item_sk:long, i_item_id:string]
                          Filter(((#2>=lit(0.99:decimal(7,2))) and (#2<=lit(1.49:decimal(7,2)))), keep=0,1) -> [i_item_sk:long, i_item_id:string]
                            Scan[item](columns=i_item_sk,i_item_id,i_current_price) -> [i_item_sk:long, i_item_id:string, i_current_price:decimal(7,2)]
                      Morsel[parallelism=N] -> [w_warehouse_sk:long, w_warehouse_name:string]
