-- q12#1
Scan[web_sales](columns=ws_sold_date_sk,ws_item_sk,ws_ext_sales_price join_filter=ws_sold_date_sk,ws_item_sk) -> [ws_sold_date_sk:long, ws_item_sk:long, ws_ext_sales_price:decimal(7,2)]
  Scan[date_dim](columns=d_date_sk filter=And(Compare(d_date,GtEq,1999-02-22),Compare(d_date,LtEq,1999-03-24)) row_filter=And(Compare(d_date,GtEq,1999-02-22),Compare(d_date,LtEq,1999-03-24))) -> [d_date_sk:long]
  ↓ Morsel[parallelism=N] -> [d_date_sk:long]
↙ HashJoin[Inner](#0 = #0) -> [ws_sold_date_sk:long, ws_item_sk:long, ws_ext_sales_price:decimal(7,2), d_date_sk:long]
  Scan[item](columns=i_item_sk,i_item_id,i_item_desc,i_current_price,i_class,i_category filter=Or(Or(Compare(i_category,Eq,Sports),Compare(i_category,Eq,Books)),Compare(i_category,Eq,Home))) -> [i_item_sk:long, i_item_id:string, i_item_desc:string, i_current_price:decimal(7,2), i_class:string, i_category:string]
  ↓ Filter(in(#5,Sports,Books,Home,false)) -> [i_item_sk:long, i_item_id:string, i_item_desc:string, i_current_price:decimal(7,2), i_class:string, i_category:string]
  ↓ Morsel[parallelism=N] -> [i_item_sk:long, i_item_id:string, i_item_desc:string, i_current_price:decimal(7,2), i_class:string, i_category:string]
↙ HashJoin[Inner](#1 = #0) -> [ws_sold_date_sk:long, ws_item_sk:long, ws_ext_sales_price:decimal(7,2), d_date_sk:long, i_item_sk:long, i_item_id:string, i_item_desc:string, i_current_price:decimal(7,2), i_class:string, i_category:string]
↓ HashAgg(keys=[#5, #6, #9, #8, #7], aggs=[agg:sum(#2)]) -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), __partial_0:decimal(38,2)]
↓ PartitionRoute -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), __partial_0:decimal(38,2), __key_hash:int]
↓ Morsel[parallelism=N] -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), __partial_0:decimal(38,2), __key_hash:int]
↓ PartitionedAgg[parallelism=N](keys=[#0, #1, #2, #3, #4], aggs=[agg:sum(#5)]) -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), __final_0:decimal(38,2)]
↓ Project(#0, #1, #2, #3, #4, #5) -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), agg:sum(#23):decimal(38,2)]
↓ Window[parallelism=N](win:sum(#5) over(#3;;None)) -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), agg:sum(#23):decimal(38,2), __wv_win0:decimal(38,2)]
↓ Project(#0, #1, #2, #3, #4, #5, ((#5*lit(100.0000:decimal(7,4)))/#6)) -> [i_item_id:string, i_item_desc:string, i_category:string, i_class:string, i_current_price:decimal(7,2), itemrevenue:decimal(38,2), revenueratio:double]
