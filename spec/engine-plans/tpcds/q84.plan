                  HashJoin[Inner](#4 = #0) -> [c_customer_id:string, c_current_cdemo_sk:long, c_first_name:string, c_last_name:string, hd_income_band_sk:long, ib_income_band_sk:long]
                    Project(#2, #3, #6, #7, #1) -> [c_customer_id:string, c_current_cdemo_sk:long, c_first_name:string, c_last_name:string, hd_income_band_sk:long]
                      HashJoin[Inner](#0 = #2) -> [hd_demo_sk:long, hd_income_band_sk:long, c_customer_id:string, c_current_cdemo_sk:long, c_current_hdemo_sk:long, c_current_addr_sk:long, c_first_name:string, c_last_name:string, ca_address_sk:long]
                        Scan[household_demographics](columns=hd_demo_sk,hd_income_band_sk) -> [hd_demo_sk:long, hd_income_band_sk:long]
                        Morsel[parallelism=N] -> [c_customer_id:string, c_current_cdemo_sk:long, c_current_hdemo_sk:long, c_current_addr_sk:long, c_first_name:string, c_last_name:string, ca_address_sk:long]
                          HashJoin[Inner](#3 = #0) -> [c_customer_id:string, c_current_cdemo_sk:long, c_current_hdemo_sk:long, c_current_addr_sk:long, c_first_name:string, c_last_name:string, ca_address_sk:long]
                            Scan[customer](columns=c_customer_id,c_current_cdemo_sk,c_current_hdemo_sk,c_current_addr_sk,c_first_name,c_last_name) -> [c_customer_id:string, c_current_cdemo_sk:long, c_current_hdemo_sk:long, c_current_addr_sk:long, c_first_name:string, c_last_name:string]
                            Morsel[parallelism=N] -> [ca_address_sk:long]
                              Filter((#1=lit(Edgewood:string)), keep=0) -> [ca_address_sk:long]
                                Scan[customer_address](columns=ca_address_sk,ca_city filter=Compare(ca_city,Eq,Edgewood)) -> [ca_address_sk:long, ca_city:string]
                    Morsel[parallelism=N] -> [ib_income_band_sk:long]
                      Filter(((#1>=lit(38128:long)) and (cast(#2 as long)<=(lit(38128:int)+lit(50000:int)))), keep=0) -> [ib_income_band_sk:long]
                        Scan[income_band]( filter=Compare(ib_lower_bound,GtEq,38128)) -> [ib_income_band_sk:long, ib_lower_bound:long, ib_upper_bound:int]
