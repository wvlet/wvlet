-- q84#1
Sort[parallelism=N](#0, limit=100) -> [customer_id:string, customername:string]
  Morsel[parallelism=N] -> [customer_id:string, customername:string]
    Project(#0, concat(concat(coalesce(#2,lit(:string)),lit(, :string)),coalesce(#1,lit(:string)))) -> [customer_id:string, customername:string]
      Project(#1, #2, #3) -> [c_customer_id:string, c_first_name:string, c_last_name:string]
        HashJoin[Inner](#0 = #3) -> [sr_cdemo_sk:long, c_customer_id:string, c_first_name:string, c_last_name:string, cd_demo_sk:long]
          Scan[store_returns](columns=sr_cdemo_sk) -> [sr_cdemo_sk:long]
          Morsel[parallelism=N] -> [c_customer_id:string, c_first_name:string, c_last_name:string, cd_demo_sk:long]
            Project(#1, #3, #4, #0) -> [c_customer_id:string, c_first_name:string, c_last_name:string, cd_demo_sk:long]
              HashJoin[Inner](#0 = #1) -> [cd_demo_sk:long, c_customer_id:string, c_current_cdemo_sk:long, c_first_name:string, c_last_name:string, hd_income_band_sk:long, ib_income_band_sk:long]
                Scan[customer_demographics](columns=cd_demo_sk) -> [cd_demo_sk:long]
