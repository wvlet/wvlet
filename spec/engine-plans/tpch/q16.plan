-- q16#1
Scan[partsupp](columns=ps_partkey,ps_suppkey join_filter=ps_partkey) -> [ps_partkey:long, ps_suppkey:long]
  Scan[part](columns=p_partkey,p_brand,p_type,p_size filter=Or(Or(Or(Or(Or(Or(Or(Compare(p_size,Eq,14),Compare(p_size,Eq,9)),Compare(p_size,Eq,45)),Compare(p_size,Eq,49)),Compare(p_size,Eq,3)),Compare(p_size,Eq,23)),Compare(p_size,Eq,36)),Compare(p_size,Eq,19)) row_filter=Or(Or(Or(Or(Or(Or(Or(Compare(p_size,Eq,14),Compare(p_size,Eq,9)),Compare(p_size,Eq,45)),Compare(p_size,Eq,49)),Compare(p_size,Eq,3)),Compare(p_size,Eq,23)),Compare(p_size,Eq,36)),Compare(p_size,Eq,19))) -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
  ↓ Filter(((#1!=lit(Brand#45:string)) and not(like(#2,MEDIUM POLISHED%,false,false)))) -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
  ↓ Morsel[parallelism=N] -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
↙ HashJoin[Inner](#0 = #0) -> [ps_partkey:long, ps_suppkey:long, p_partkey:long, p_brand:string, p_type:string, p_size:int]
↓ Morsel[parallelism=N] -> [ps_partkey:long, ps_suppkey:long, p_partkey:long, p_brand:string, p_type:string, p_size:int]
↓ PartitionedAgg[parallelism=N](keys=[#3, #4, #5], aggs=[agg:count(distinct #1)]) -> [p_brand:string, p_type:string, p_size:int, agg:count(distinct #1):long]
↓ Project(#0, #1, #2, #3) -> [p_brand:string, p_type:string, p_size:int, supplier_cnt:long]
↓ Sort[parallelism=N](#3 desc, #0, #1, #2) -> [p_brand:string, p_type:string, p_size:int, supplier_cnt:long]
