-- q16#1
Scan[partsupp](columns=ps_partkey,ps_suppkey) -> [ps_partkey:long, ps_suppkey:long]
  Scan[part](columns=p_partkey,p_brand,p_type,p_size filter=Or(Or(Or(Or(Or(Or(Or(Compare(p_size,Eq,14),Compare(p_size,Eq,9)),Compare(p_size,Eq,45)),Compare(p_size,Eq,49)),Compare(p_size,Eq,3)),Compare(p_size,Eq,23)),Compare(p_size,Eq,36)),Compare(p_size,Eq,19))) -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
  ↓ Filter((((#1!=lit(Brand#45:string)) and not(like(#2,MEDIUM POLISHED%,false,false))) and in(#3,14,9,45,49,3,23,36,19,false))) -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
  ↓ Morsel[parallelism=N] -> [p_partkey:long, p_brand:string, p_type:string, p_size:int]
↙ HashJoin[Inner](#0 = #0) -> [ps_partkey:long, ps_suppkey:long, p_partkey:long, p_brand:string, p_type:string, p_size:int]
↓ Filter(is_null(#1,true), keep=1,3,4,5) -> [ps_suppkey:long, p_brand:string, p_type:string, p_size:int]
  Values -> [s_suppkey:long]
↙ HashJoin[Anti](#0 = #0) -> [ps_suppkey:long, p_brand:string, p_type:string, p_size:int]
↓ Morsel[parallelism=N] -> [ps_suppkey:long, p_brand:string, p_type:string, p_size:int]
↓ PartitionedAgg[parallelism=N](keys=[#1, #2, #3], aggs=[agg:count(distinct #0)]) -> [p_brand:string, p_type:string, p_size:int, agg:count(distinct #1):long]
↓ Project(#0, #1, #2, #3) -> [p_brand:string, p_type:string, p_size:int, supplier_cnt:long]
↓ Sort[parallelism=N](#3 desc, #0, #1, #2) -> [p_brand:string, p_type:string, p_size:int, supplier_cnt:long]
