-- q20#1
Sort[parallelism=N](#0) -> [s_name:string, s_address:string]
  Project(#1, #2) -> [s_name:string, s_address:string]
    HashJoin[RightSemi](#0 = #0) -> [s_suppkey:long, s_name:string, s_address:string, s_nationkey:int, n_nationkey:int]
      Morsel[parallelism=N] -> [ps_suppkey:long]
        Project(#0) -> [ps_suppkey:long]
          Project(#0) -> [ps_suppkey:long]
            Filter((cast(#2 as decimal(38,3))>#5), keep=1) -> [ps_suppkey:long]
              HashJoin[Left](#0,#1 = #0,#1) -> [ps_partkey:long, ps_suppkey:long, ps_availqty:long, __wv_k4:long, __wv_k5:long, __wv_sq6:decimal(38,3)]
                HashJoin[Semi](#0 = #0) -> [ps_partkey:long, ps_suppkey:long, ps_availqty:long]
                  Scan[partsupp](columns=ps_partkey,ps_suppkey,ps_availqty) -> [ps_partkey:long, ps_suppkey:long, ps_availqty:long]
                  Morsel[parallelism=N] -> [p_partkey:long]
                    Project(#0) -> [p_partkey:long]
                      Filter(like(#1,forest%,false,false), keep=0) -> [p_partkey:long]
                        Scan[part](columns=p_partkey,p_name) -> [p_partkey:long, p_name:string]
                Project(#0, #1, (lit(0.5:decimal(1,1))*#2)) -> [__wv_k4:long, __wv_k5:long, __wv_sq6:decimal(38,3)]
                  Project(#0, #1, #2) -> [__wv_k4:long, __wv_k5:long, agg:sum(#4):decimal(38,2)]
                    PartitionedAgg[parallelism=N](keys=[#0, #1], aggs=[agg:sum(#2)]) -> [__wv_k4:long, __wv_k5:long, __final_0:decimal(38,2)]
                      Morsel[parallelism=N] -> [__wv_k4:long, __wv_k5:long, __partial_0:decimal(38,2)]
                        HashAgg(keys=[#0, #1], aggs=[agg:sum(#2)]) -> [__wv_k4:long, __wv_k5:long, __partial_0:decimal(38,2)]
                          Filter(((#3>=lit(8766:date)) and (#3<lit(9131:date))), keep=0,1,2) -> [l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2)]
                            Scan[lineitem](columns=l_partkey,l_suppkey,l_quantity,l_shipdate filter=And(Compare(l_shipdate,GtEq,1994-01-01),Compare(l_shipdate,Lt,1995-01-01))) -> [l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_shipdate:date]
      Morsel[parallelism=N] -> [s_suppkey:long, s_name:string, s_address:string, s_nationkey:int, n_nationkey:int]
        HashJoin[Inner](#3 = #0) -> [s_suppkey:long, s_name:string, s_address:string, s_nationkey:int, n_nationkey:int]
          Scan[supplier](columns=s_suppkey,s_name,s_address,s_nationkey) -> [s_suppkey:long, s_name:string, s_address:string, s_nationkey:int]
          Morsel[parallelism=N] -> [n_nationkey:int]
            Filter((#1=lit(CANADA:string)), keep=0) -> [n_nationkey:int]
              Scan[nation](columns=n_nationkey,n_name filter=Compare(n_name,Eq,CANADA)) -> [n_nationkey:int, n_name:string]
