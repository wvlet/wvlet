-- q13-opt#1
Scan[orders](columns=o_custkey,o_comment join_filter=o_custkey) -> [o_custkey:long, o_comment:string]
  Scan[customer](columns=c_custkey) -> [c_custkey:long]
  ↓ Morsel[parallelism=N] -> [c_custkey:long]
↙ HashJoin[Right](#0 = #0, residual=like(#1,%special%requests%,true,false)) -> [o_custkey:long, o_comment:string, c_custkey:long]
↓ Project(#2) -> [c_custkey:long]
↓ HashAgg(keys=[#0], aggs=[agg:count_star()]) -> [c_custkey:long, __partial_0:long]
↓ Morsel[parallelism=N] -> [c_custkey:long, __partial_0:long]
↓ PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:sum(#1)]) -> [c_custkey:long, __final_0:long]
↓ Project(#0, #1) -> [c_custkey:long, agg:count_star():long]
↓ Project(#1) -> [c_count:long]
↓ PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:count_star()]) -> [c_count:long, agg:count_star():long]
↓ Project(#0, #1) -> [c_count:long, custdist:long]
↓ Sort[parallelism=N](#1 desc, #0 desc) -> [c_count:long, custdist:long]
