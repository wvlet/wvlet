-- q8#1
Scan[supplier](columns=s_suppkey,s_nationkey join_filter=s_suppkey,s_nationkey) -> [s_suppkey:long, s_nationkey:int]
  Scan[lineitem](columns=l_orderkey,l_partkey,l_suppkey,l_extendedprice,l_discount join_filter=l_orderkey,l_partkey) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
    Scan[orders](columns=o_orderkey,o_custkey,o_orderdate filter=And(Compare(o_orderdate,GtEq,1995-01-01),Compare(o_orderdate,LtEq,1996-12-31)) join_filter=o_custkey) -> [o_orderkey:long, o_custkey:long, o_orderdate:date]
    ↓ Filter(((lit(9131:date)<=#2) and (#2<=lit(9861:date)))) -> [o_orderkey:long, o_custkey:long, o_orderdate:date]
      Scan[customer](columns=c_custkey,c_nationkey join_filter=c_nationkey) -> [c_custkey:long, c_nationkey:int]
        Scan[nation](columns=n_nationkey,n_regionkey join_filter=n_regionkey) -> [n_nationkey:int, n_regionkey:int]
          Scan[region](columns=r_regionkey,r_name filter=Compare(r_name,Eq,AMERICA)) -> [r_regionkey:int, r_name:string]
          ↓ Filter((#1=lit(AMERICA:string)), keep=0) -> [r_regionkey:int]
          ↓ Morsel[parallelism=N] -> [r_regionkey:int]
        ↙ HashJoin[Inner](#1 = #0) -> [n_nationkey:int, n_regionkey:int, r_regionkey:int]
        ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_regionkey:int, r_regionkey:int]
      ↙ HashJoin[Inner](#1 = #0) -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int]
      ↓ Morsel[parallelism=N] -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int]
    ↙ HashJoin[Inner](#1 = #0) -> [o_orderkey:long, o_custkey:long, o_orderdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int]
    ↓ Morsel[parallelism=N] -> [o_orderkey:long, o_custkey:long, o_orderdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int]
  ↙ HashJoin[Inner](#0 = #0) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderkey:long, o_custkey:long, o_orderdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int]
    Scan[part](columns=p_partkey,p_type filter=Compare(p_type,Eq,ECONOMY ANODIZED STEEL)) -> [p_partkey:long, p_type:string]
    ↓ Filter((#1=lit(ECONOMY ANODIZED STEEL:string)), keep=0) -> [p_partkey:long]
    ↓ Morsel[parallelism=N] -> [p_partkey:long]
  ↙ HashJoin[Inner](#1 = #0) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderkey:long, o_custkey:long, o_orderdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_regionkey:int, r_regionkey:int, p_partkey:long]
  ↓ Project(#2, #3, #4, #7) -> [l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderdate:date]
  ↓ Morsel[parallelism=N] -> [l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderdate:date]
↙ HashJoin[Inner](#0 = #0) -> [s_suppkey:long, s_nationkey:int, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderdate:date]
↓ Project(#3, #4, #5, #1) -> [l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderdate:date, s_nationkey:int]
  Scan[nation](columns=n_nationkey,n_name) -> [n_nationkey:int, n_name:string]
  ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
↙ HashJoin[Inner](#3 = #0) -> [l_extendedprice:decimal(15,2), l_discount:decimal(15,2), o_orderdate:date, s_nationkey:int, n_nationkey:int, n_name:string]
↓ Project(date_part(#2), (#0*(lit(1:int)-#1)), #5) -> [o_year:long, volume:decimal(31,4), nation:string]
↓ Project(#0, #1, #2) -> [o_year:long, volume:decimal(31,4), nation:string]
↓ HashAgg(keys=[#0], aggs=[agg:sum(case((#2=lit(BRAZIL:string))->#1;Some(lit(0:int)))), agg:sum(#1)]) -> [o_year:long, __partial_0:decimal(38,4), __partial_1:decimal(38,4)]
↓ Morsel[parallelism=N] -> [o_year:long, __partial_0:decimal(38,4), __partial_1:decimal(38,4)]
↓ PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:sum(#1), agg:sum(#2)]) -> [o_year:long, __final_0:decimal(38,4), __final_1:decimal(38,4)]
↓ Project(#0, #1, #2) -> [o_year:long, agg:sum(case((#2=lit(BRAZIL:string))->#1;Some(lit(0:int)))):decimal(38,4), agg:sum(#1):decimal(38,4)]
↓ Project(#0, (#1/#2)) -> [o_year:long, mkt_share:double]
↓ Sort[parallelism=N](#0) -> [o_year:long, mkt_share:double]
