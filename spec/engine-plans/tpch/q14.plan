-- q14#1
Scan[lineitem](columns=l_partkey,l_extendedprice,l_discount,l_shipdate filter=And(Compare(l_shipdate,GtEq,1995-09-01),Compare(l_shipdate,Lt,1995-10-01))) -> [l_partkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
↓ Filter(((#3>=lit(9374:date)) and (#3<lit(9404:date))), keep=0,1,2) -> [l_partkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
  Scan[part](columns=p_partkey,p_type) -> [p_partkey:long, p_type:string]
  ↓ Morsel[parallelism=N] -> [p_partkey:long, p_type:string]
↙ HashJoin[Inner](#0 = #0) -> [l_partkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), p_partkey:long, p_type:string]
↓ HashAgg(keys=[], aggs=[agg:sum(case(like(#4,PROMO%,false,false)->(#1*(lit(1:int)-#2));Some(lit(0:int)))), agg:sum((#1*(lit(1:int)-#2)))]) -> [__partial_0:decimal(38,4), __partial_1:decimal(38,4)]
↓ Morsel[parallelism=N] -> [__partial_0:decimal(38,4), __partial_1:decimal(38,4)]
↓ HashAgg(keys=[], aggs=[agg:sum(#0), agg:sum(#1)]) -> [__final_0:decimal(38,4), __final_1:decimal(38,4)]
↓ Project(#0, #1) -> [agg:sum(case(like(#20,PROMO%,false,false)->(#5*(lit(1:int)-#6));Some(lit(0:int)))):decimal(38,4), agg:sum((#5*(lit(1:int)-#6))):decimal(38,4)]
↓ Project(((lit(100.00:decimal(5,2))*#0)/#1)) -> [promo_revenue:double]
