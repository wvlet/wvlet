Scan[orders](columns=o_orderkey,o_custkey join_filter=o_orderkey,o_custkey) -> [o_orderkey:long, o_custkey:long]
  Scan[lineitem](columns=l_orderkey,l_suppkey,l_extendedprice,l_discount,l_shipdate filter=And(Compare(l_shipdate,GtEq,1995-01-01),Compare(l_shipdate,LtEq,1996-12-31)) row_filter=And(Compare(l_shipdate,GtEq,1995-01-01),Compare(l_shipdate,LtEq,1996-12-31)) join_filter=l_suppkey) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
    Scan[supplier](columns=s_suppkey,s_nationkey join_filter=s_nationkey) -> [s_suppkey:long, s_nationkey:int]
      Scan[nation](columns=n_nationkey,n_name filter=Or(Compare(n_name,Eq,FRANCE),Compare(n_name,Eq,GERMANY)) row_filter=Or(Compare(n_name,Eq,FRANCE),Compare(n_name,Eq,GERMANY))) -> [n_nationkey:int, n_name:string]
      ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
