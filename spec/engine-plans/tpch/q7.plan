    ↓ Morsel[parallelism=N] -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#1 = #0) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
  ↓ Project(#8, #0, #2, #3, #4) -> [n_name:string, l_orderkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
  ↓ Morsel[parallelism=N] -> [n_name:string, l_orderkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
↙ HashJoin[Inner](#0 = #1) -> [o_orderkey:long, o_custkey:long, n_name:string, l_orderkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
↓ Project(#2, #4, #5, #6, #1) -> [n_name:string, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, o_custkey:long]
  Scan[customer](columns=c_custkey,c_nationkey join_filter=c_nationkey) -> [c_custkey:long, c_nationkey:int]
    Scan[nation](columns=n_nationkey,n_name filter=Or(Compare(n_name,Eq,GERMANY),Compare(n_name,Eq,FRANCE)) row_filter=Or(Compare(n_name,Eq,GERMANY),Compare(n_name,Eq,FRANCE))) -> [n_nationkey:int, n_name:string]
    ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#1 = #0) -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
  ↓ Morsel[parallelism=N] -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
↙ HashJoin[Inner](#4 = #0) -> [n_name:string, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, o_custkey:long, c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
