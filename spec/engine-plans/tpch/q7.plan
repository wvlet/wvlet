-- q7#1
Scan[lineitem](columns=l_orderkey,l_suppkey,l_extendedprice,l_discount,l_shipdate filter=And(Compare(l_shipdate,GtEq,1995-01-01),Compare(l_shipdate,LtEq,1996-12-31)) join_filter=l_orderkey,l_suppkey) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
