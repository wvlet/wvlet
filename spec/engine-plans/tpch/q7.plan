-- q7#1
Scan[orders](columns=o_orderkey,o_custkey) -> [o_orderkey:long, o_custkey:long]
  Scan[lineitem](columns=l_orderkey,l_suppkey,l_extendedprice,l_discount,l_shipdate filter=And(Compare(l_shipdate,GtEq,1995-01-01),Compare(l_shipdate,LtEq,1996-12-31))) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
  ↓ Filter(((lit(9131:date)<=#4) and (#4<=lit(9861:date)))) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
  ↓ Morsel[parallelism=N] -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
↙ HashJoin[Inner](#0 = #0) -> [o_orderkey:long, o_custkey:long, l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date]
  Scan[customer](columns=c_custkey,c_nationkey) -> [c_custkey:long, c_nationkey:int]
    Scan[nation](columns=n_nationkey,n_name) -> [n_nationkey:int, n_name:string]
    ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#1 = #0) -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
  ↓ Morsel[parallelism=N] -> [c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
↙ HashJoin[Inner](#1 = #0) -> [o_orderkey:long, o_custkey:long, l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
  Scan[supplier](columns=s_suppkey,s_nationkey) -> [s_suppkey:long, s_nationkey:int]
    Scan[nation](columns=n_nationkey,n_name) -> [n_nationkey:int, n_name:string]
    ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#1 = #0) -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
  ↓ Morsel[parallelism=N] -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
↙ HashJoin[Inner](#3 = #0) -> [o_orderkey:long, o_custkey:long, l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string, s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
↓ Project(#14, #4, #5, #6, #10) -> [n_name:string, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, n_name:string]
↓ Filter((((#0=lit(FRANCE:string)) and (#4=lit(GERMANY:string))) or ((#0=lit(GERMANY:string)) and (#4=lit(FRANCE:string))))) -> [n_name:string, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, n_name:string]
↓ Project(#0, #4, date_part(#3), (#1*(lit(1:int)-#2))) -> [supp_nation:string, cust_nation:string, l_year:long, volume:decimal(31,4)]
↓ Project(#0, #1, #2, #3) -> [supp_nation:string, cust_nation:string, l_year:long, volume:decimal(31,4)]
↓ HashAgg(keys=[#0, #1, #2], aggs=[agg:sum(#3)]) -> [supp_nation:string, cust_nation:string, l_year:long, __partial_0:decimal(38,4)]
↓ Morsel[parallelism=N] -> [supp_nation:string, cust_nation:string, l_year:long, __partial_0:decimal(38,4)]
↓ PartitionedAgg[parallelism=N](keys=[#0, #1, #2], aggs=[agg:sum(#3)]) -> [supp_nation:string, cust_nation:string, l_year:long, __final_0:decimal(38,4)]
↓ Project(#0, #1, #2, #3) -> [supp_nation:string, cust_nation:string, l_year:long, agg:sum(#3):decimal(38,4)]
