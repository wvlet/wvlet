↙ HashJoin[Inner](#0 = #0) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, o_orderkey:long, o_custkey:long, c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string]
  Scan[supplier](columns=s_suppkey,s_nationkey join_filter=s_nationkey) -> [s_suppkey:long, s_nationkey:int]
    Scan[nation](columns=n_nationkey,n_name filter=Or(Compare(n_name,Eq,FRANCE),Compare(n_name,Eq,GERMANY))) -> [n_nationkey:int, n_name:string]
    ↓ Filter(((#1=lit(FRANCE:string)) or (#1=lit(GERMANY:string)))) -> [n_nationkey:int, n_name:string]
    ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#1 = #0) -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
  ↓ Morsel[parallelism=N] -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
↙ HashJoin[Inner](#1 = #0) -> [l_orderkey:long, l_suppkey:long, l_extendedprice:decimal(15,2), l_discount:decimal(15,2), l_shipdate:date, o_orderkey:long, o_custkey:long, c_custkey:long, c_nationkey:int, n_nationkey:int, n_name:string, s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
