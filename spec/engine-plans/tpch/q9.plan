    ↓ Morsel[parallelism=N] -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
  ↙ HashJoin[Inner](#1,#0 = #2,#1) -> [ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2), l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
  ↓ Morsel[parallelism=N] -> [ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2), l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
↙ HashJoin[Inner](#0 = #3) -> [o_orderkey:long, o_orderdate:date, ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2), l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
