Scan[orders](columns=o_orderkey,o_orderdate join_filter=o_orderkey) -> [o_orderkey:long, o_orderdate:date]
  Scan[partsupp](columns=ps_partkey,ps_suppkey,ps_supplycost join_filter=ps_partkey,ps_suppkey) -> [ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
    Scan[lineitem](columns=l_orderkey,l_partkey,l_suppkey,l_quantity,l_extendedprice,l_discount join_filter=l_partkey) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
      Scan[part](columns=p_partkey,p_name) -> [p_partkey:long, p_name:string]
      ↓ Filter(like(#1,%green%,false,false), keep=0) -> [p_partkey:long]
      ↓ Morsel[parallelism=N] -> [p_partkey:long]
