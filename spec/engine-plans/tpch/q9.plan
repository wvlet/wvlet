-- q9#1
Scan[orders](columns=o_orderkey,o_orderdate join_filter=o_orderkey) -> [o_orderkey:long, o_orderdate:date]
  Scan[lineitem](columns=l_orderkey,l_partkey,l_suppkey,l_quantity,l_extendedprice,l_discount join_filter=l_partkey,l_suppkey) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
    Scan[part](columns=p_partkey,p_name) -> [p_partkey:long, p_name:string]
    ↓ Filter(like(#1,%green%,false,false), keep=0) -> [p_partkey:long]
    ↓ Morsel[parallelism=N] -> [p_partkey:long]
  ↙ HashJoin[Inner](#1 = #0) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), p_partkey:long]
  ↓ Project(#0, #1, #2, #3, #4, #5) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2)]
    Scan[supplier](columns=s_suppkey,s_nationkey join_filter=s_nationkey) -> [s_suppkey:long, s_nationkey:int]
      Scan[nation](columns=n_nationkey,n_name) -> [n_nationkey:int, n_name:string]
      ↓ Morsel[parallelism=N] -> [n_nationkey:int, n_name:string]
    ↙ HashJoin[Inner](#1 = #0) -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
    ↓ Morsel[parallelism=N] -> [s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
  ↙ HashJoin[Inner](#2 = #0) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string]
    Scan[partsupp](columns=ps_partkey,ps_suppkey,ps_supplycost) -> [ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
    ↓ Morsel[parallelism=N] -> [ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
  ↙ HashJoin[Inner](#2,#1 = #1,#0) -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string, ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
  ↓ Morsel[parallelism=N] -> [l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string, ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
↙ HashJoin[Inner](#0 = #0) -> [o_orderkey:long, o_orderdate:date, l_orderkey:long, l_partkey:long, l_suppkey:long, l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), s_suppkey:long, s_nationkey:int, n_nationkey:int, n_name:string, ps_partkey:long, ps_suppkey:long, ps_supplycost:decimal(15,2)]
↓ Project(#5, #6, #7, #11, #14, #1) -> [l_quantity:decimal(15,2), l_extendedprice:decimal(15,2), l_discount:decimal(15,2), n_name:string, ps_supplycost:decimal(15,2), o_orderdate:date]
↓ Project(#3, date_part(#5), ((#1*(lit(1.00:decimal(16,2))-#2))-(#4*#0))) -> [nation:string, o_year:long, amount:decimal(32,4)]
↓ Project(#0, #1, #2) -> [nation:string, o_year:long, amount:decimal(32,4)]
↓ HashAgg(keys=[#0, #1], aggs=[agg:sum(#2)]) -> [nation:string, o_year:long, __partial_0:decimal(38,4)]
