-- q4#1
Scan[lineitem](columns=l_orderkey,l_commitdate,l_receiptdate join_filter=l_orderkey) -> [l_orderkey:long, l_commitdate:date, l_receiptdate:date]
↓ Filter((#1<#2), keep=0) -> [l_orderkey:long]
  Scan[orders](columns=o_orderkey,o_orderpriority filter=And(Compare(o_orderdate,GtEq,1993-07-01),Compare(o_orderdate,Lt,1993-10-01)) row_filter=And(Compare(o_orderdate,GtEq,1993-07-01),Compare(o_orderdate,Lt,1993-10-01))) -> [o_orderkey:long, o_orderpriority:string]
  ↓ Morsel[parallelism=N] -> [o_orderkey:long, o_orderpriority:string]
↙ HashJoin[RightSemi](#0 = #0) -> [o_orderkey:long, o_orderpriority:string]
↓ HashAgg(keys=[#1], aggs=[agg:count_star()]) -> [o_orderpriority:string, __partial_0:long]
↓ Morsel[parallelism=N] -> [o_orderpriority:string, __partial_0:long]
↓ PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:sum(#1)]) -> [o_orderpriority:string, __final_0:long]
↓ Project(#0, #1) -> [o_orderpriority:string, agg:count_star():long]
↓ Project(#0, #1) -> [o_orderpriority:string, order_count:long]
↓ Sort[parallelism=N](#0) -> [o_orderpriority:string, order_count:long]
