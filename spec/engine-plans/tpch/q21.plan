-- q21#1
Sort[parallelism=N](#1 desc, #0, limit=100) -> [s_name:string, numwait:long]
  Project(#0, #1) -> [s_name:string, numwait:long]
    Project(#0, #1) -> [s_name:string, agg:count_star():long]
      PartitionedAgg[parallelism=N](keys=[#0], aggs=[agg:sum(#1)]) -> [s_name:string, __final_0:long]
        Morsel[parallelism=N] -> [s_name:string, __partial_0:long]
          HashAgg(keys=[#0], aggs=[agg:count_star()]) -> [s_name:string, __partial_0:long]
            HashJoin[RightAnti](#0 = #1, residual=(#1!=#4)) -> [s_name:string, l_orderkey:long, l_suppkey:long]
              Filter((#3>#2), keep=0,1) -> [l_orderkey:long, l_suppkey:long]
                Scan[lineitem](columns=l_orderkey,l_suppkey,l_commitdate,l_receiptdate) -> [l_orderkey:long, l_suppkey:long, l_commitdate:date, l_receiptdate:date]
              Morsel[parallelism=N] -> [s_name:string, l_orderkey:long, l_suppkey:long]
                HashJoin[RightSemi](#0 = #1, residual=(#1!=#4)) -> [s_name:string, l_orderkey:long, l_suppkey:long]
                  Scan[lineitem](columns=l_orderkey,l_suppkey) -> [l_orderkey:long, l_suppkey:long]
                  Morsel[parallelism=N] -> [s_name:string, l_orderkey:long, l_suppkey:long]
                    Project(#1, #2, #3) -> [s_name:string, l_orderkey:long, l_suppkey:long]
                      HashJoin[Inner](#0 = #1) -> [o_orderkey:long, s_name:string, l_orderkey:long, l_suppkey:long]
                        Filter((#1=lit(F:string)), keep=0) -> [o_orderkey:long]
                          Scan[orders](columns=o_orderkey,o_orderstatus filter=Compare(o_orderstatus,Eq,F)) -> [o_orderkey:long, o_orderstatus:string]
                        Morsel[parallelism=N] -> [s_name:string, l_orderkey:long, l_suppkey:long]
                          Project(#3, #0, #1) -> [s_name:string, l_orderkey:long, l_suppkey:long]
                            HashJoin[Inner](#1 = #0) -> [l_orderkey:long, l_suppkey:long, s_suppkey:long, s_name:string, s_nationkey:int, n_nationkey:int]
                              Filter((#3>#2), keep=0,1) -> [l_orderkey:long, l_suppkey:long]
                                Scan[lineitem](columns=l_orderkey,l_suppkey,l_commitdate,l_receiptdate) -> [l_orderkey:long, l_suppkey:long, l_commitdate:date, l_receiptdate:date]
                              Morsel[parallelism=N] -> [s_suppkey:long, s_name:string, s_nationkey:int, n_nationkey:int]
                                HashJoin[Inner](#2 = #0) -> [s_suppkey:long, s_name:string, s_nationkey:int, n_nationkey:int]
                                  Scan[supplier](columns=s_suppkey,s_name,s_nationkey) -> [s_suppkey:long, s_name:string, s_nationkey:int]
                                  Morsel[parallelism=N] -> [n_nationkey:int]
                                    Filter((#1=lit(SAUDI ARABIA:string)), keep=0) -> [n_nationkey:int]
                                      Scan[nation](columns=n_nationkey,n_name filter=Compare(n_name,Eq,SAUDI ARABIA)) -> [n_nationkey:int, n_name:string]
