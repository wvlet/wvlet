from web_sales, {
  { from warehouse select SUBSTRING(w_warehouse_name, 1, 20) as w_substr, * }
} as sq1
  , ship_mode
  , web_site
  , date_dim
  
where 
  d_month_seq between 1200 and 1200 + 11
  and ws_ship_date_sk = d_date_sk
  and ws_warehouse_sk = w_warehouse_sk
  and ws_ship_mode_sk = sm_ship_mode_sk
  and ws_web_site_sk = web_site_sk
group by w_substr, sm_type, web_name
select 
  w_substr,
  sm_type,
  web_name,
  sum(case  when (ws_ship_date_sk - ws_sold_date_sk <= 30) then 1  else 0)
  as `30 days`,
  sum(
    case 
      when (ws_ship_date_sk - ws_sold_date_sk > 30)
      and (ws_ship_date_sk - ws_sold_date_sk <= 60) then 1 
      else 0
  )
  as `31-60 days`,
  sum(
    case 
      when (ws_ship_date_sk - ws_sold_date_sk > 60)
      and (ws_ship_date_sk - ws_sold_date_sk <= 90) then 1 
      else 0
  )
  as `61-90 days`,
  sum(
    case 
      when (ws_ship_date_sk - ws_sold_date_sk > 90)
      and (ws_ship_date_sk - ws_sold_date_sk <= 120) then 1 
      else 0
  )
  as `91-120 days`,
  sum(case  when (ws_ship_date_sk - ws_sold_date_sk > 120) then 1  else 0)
  as `>120 days`
order by 1 nulls first, 2 nulls first, 3 nulls first
limit 100
