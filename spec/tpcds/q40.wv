from catalog_sales
left join catalog_returns
  on (cs_order_number = cr_order_number and cs_item_sk = cr_item_sk), warehouse
  , item
  , date_dim
  
where 
  i_current_price between 0.99 and 1.49
  and i_item_sk = cs_item_sk
  and cs_warehouse_sk = w_warehouse_sk
  and cs_sold_date_sk = d_date_sk
  and d_date between '2000-02-10'::date and '2000-04-10'::date
group by w_state, i_item_id
select 
  w_state,
  i_item_id,
  sum(
    case 
      when (d_date::date < '2000-03-11'::date) then cs_sales_price - coalesce(cr_refunded_cash, 0) 
      else 0
  )
  as sales_before,
  sum(
    case 
      when (d_date::date >= '2000-03-11'::date) then cs_sales_price - coalesce(cr_refunded_cash, 0) 
      else 0
  )
  as sales_after
order by w_state, i_item_id
limit 100
