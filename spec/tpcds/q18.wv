from catalog_sales, customer_demographics as cd1 , customer_demographics as cd2 , customer
  , customer_address
  , date_dim
  , item
  
where 
  cs_sold_date_sk = d_date_sk
  and cs_item_sk = i_item_sk
  and cs_bill_cdemo_sk = cd1.cd_demo_sk
  and cs_bill_customer_sk = c_customer_sk
  and cd1.cd_gender = 'F'
  and cd1.cd_education_status = 'Unknown'
  and c_current_cdemo_sk = cd2.cd_demo_sk
  and c_current_addr_sk = ca_address_sk
  and c_birth_month in (1, 6, 8, 9, 12, 2)
  and d_year = 1998
  and ca_state in ('MS', 'IN', 'ND', 'OK', 'NM', 'VA', 'MS')
group by rollup(i_item_id, ca_country, ca_state, ca_county)
select 
  i_item_id,
  ca_country,
  ca_state,
  ca_county,
  avg(cs_quantity::decimal[12,2]) as agg1,
  avg(cs_list_price::decimal[12,2]) as agg2,
  avg(cs_coupon_amt::decimal[12,2]) as agg3,
  avg(cs_sales_price::decimal[12,2]) as agg4,
  avg(cs_net_profit::decimal[12,2]) as agg5,
  avg(c_birth_year::decimal[12,2]) as agg6,
  avg(cd1.cd_dep_count::decimal[12,2]) as agg7
order by 
  ca_country nulls first,
  ca_state nulls first,
  ca_county nulls first,
  i_item_id nulls first
limit 100
