with frequent_ss_items as {
  from store_sales, date_dim , {
  { from item select SUBSTRING(i_item_desc, 1, 30) as itemdesc, * }
  } as sq1
    
  where 
    ss_sold_date_sk = d_date_sk
    and ss_item_sk = i_item_sk
    and d_year in (2000, 2000 + 1, 2000 + 2, 2000 + 3)
  group by itemdesc, i_item_sk, d_date
  where count(*) > 4
  select itemdesc, i_item_sk as item_sk, d_date as solddate, count(*) as cnt
}
with max_store_sales as {
  from {
    {
      from store_sales, customer , date_dim 
      where 
        ss_customer_sk = c_customer_sk
        and ss_sold_date_sk = d_date_sk
        and d_year in (2000, 2000 + 1, 2000 + 2, 2000 + 3)
      group by c_customer_sk
      select c_customer_sk, sum(ss_quantity * ss_sales_price) as csales
    }
  } as sq2
  select max(csales) as tpcds_cmax
}
with best_ss_customer as {
  from store_sales, customer , max_store_sales 
  where ss_customer_sk = c_customer_sk
  group by c_customer_sk
  where sum(ss_quantity * ss_sales_price) > (50 / 100.0) * max(tpcds_cmax)
  select c_customer_sk, sum(ss_quantity * ss_sales_price) as ssales
}
from {
  {
    from catalog_sales, customer , date_dim , frequent_ss_items , best_ss_customer
      
    where 
      d_year = 2000
      and d_moy = 2
      and cs_sold_date_sk = d_date_sk
      and cs_item_sk = item_sk
      and cs_bill_customer_sk = best_ss_customer.c_customer_sk
      and cs_bill_customer_sk = customer.c_customer_sk
    group by c_last_name, c_first_name
    select c_last_name, c_first_name, sum(cs_quantity * cs_list_price) as sales
    concat
    {
      from web_sales, customer , date_dim , frequent_ss_items , best_ss_customer
        
      where 
        d_year = 2000
        and d_moy = 2
        and ws_sold_date_sk = d_date_sk
        and ws_item_sk = item_sk
        and ws_bill_customer_sk = best_ss_customer.c_customer_sk
        and ws_bill_customer_sk = customer.c_customer_sk
      group by c_last_name, c_first_name
      select 
        c_last_name,
        c_first_name,
        sum(ws_quantity * ws_list_price) as sales
    }
  }
} as sq3
select c_last_name, c_first_name, sales
order by c_last_name nulls first, c_first_name nulls first, sales nulls first
limit 100
