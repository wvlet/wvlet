with ss as {
  from store_sales, date_dim , store 
  where 
    ss_sold_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
    and ss_store_sk = s_store_sk
  group by s_store_sk
  select 
    s_store_sk,
    sum(ss_ext_sales_price) as sales,
    sum(ss_net_profit) as profit
}
with sr as {
  from store_returns, date_dim , store 
  where 
    sr_returned_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
    and sr_store_sk = s_store_sk
  group by s_store_sk
  select 
    s_store_sk,
    sum(sr_return_amt) as returns_,
    sum(sr_net_loss) as profit_loss
}
with cs as {
  from catalog_sales, date_dim 
  where 
    cs_sold_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
  group by cs_call_center_sk
  select 
    cs_call_center_sk,
    sum(cs_ext_sales_price) as sales,
    sum(cs_net_profit) as profit
}
with cr as {
  from catalog_returns, date_dim 
  where 
    cr_returned_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
  group by cr_call_center_sk
  select 
    cr_call_center_sk,
    sum(cr_return_amount) as returns_,
    sum(cr_net_loss) as profit_loss
}
with ws as {
  from web_sales, date_dim , web_page 
  where 
    ws_sold_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
    and ws_web_page_sk = wp_web_page_sk
  group by wp_web_page_sk
  select 
    wp_web_page_sk,
    sum(ws_ext_sales_price) as sales,
    sum(ws_net_profit) as profit
}
with wr as {
  from web_returns, date_dim , web_page 
  where 
    wr_returned_date_sk = d_date_sk
    and d_date between '2000-08-23'::date and '2000-09-22'::date
    and wr_web_page_sk = wp_web_page_sk
  group by wp_web_page_sk
  select 
    wp_web_page_sk,
    sum(wr_return_amt) as returns_,
    sum(wr_net_loss) as profit_loss
}
from {
  {
    from ss left join sr on ss.s_store_sk = sr.s_store_sk
    select 
      'store channel' as channel,
      ss.s_store_sk as id,
      sales,
      coalesce(returns_, 0) as returns_,
      (profit - coalesce(profit_loss, 0)) as profit
    concat
    {
      from cs, cr 
      select 
        'catalog channel' as channel,
        cs_call_center_sk as id,
        sales,
        returns_,
        (profit - profit_loss) as profit
      concat
      {
        from ws left join wr on ws.wp_web_page_sk = wr.wp_web_page_sk
        select 
          'web channel' as channel,
          ws.wp_web_page_sk as id,
          sales,
          coalesce(returns_, 0) as returns_,
          (profit - coalesce(profit_loss, 0)) as profit
      }
    }
  }
} as x
group by rollup(channel, id)
select 
  channel,
  id,
  sum(sales) as sales,
  sum(returns_) as returns_,
  sum(profit) as profit
order by channel nulls first, id nulls first, returns_ desc
limit 100
