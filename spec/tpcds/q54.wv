with my_customers as {
  from {
    {
      from catalog_sales
      select 
        cs_sold_date_sk as sold_date_sk,
        cs_bill_customer_sk as customer_sk,
        cs_item_sk as item_sk
      concat
      {
        from web_sales
        select 
          ws_sold_date_sk as sold_date_sk,
          ws_bill_customer_sk as customer_sk,
          ws_item_sk as item_sk
      }
    }
  } as cs_or_ws_sales, item
    , date_dim
    , customer
    
  where 
    sold_date_sk = d_date_sk
    and item_sk = i_item_sk
    and i_category = 'Women'
    and i_class = 'maternity'
    and c_customer_sk = cs_or_ws_sales.customer_sk
    and d_moy = 12
    and d_year = 1998
  select distinct c_customer_sk, c_current_addr_sk
}
with my_revenue as {
  from my_customers, store_sales , customer_address , store , date_dim 
  where 
    c_current_addr_sk = ca_address_sk
    and ca_county = s_county
    and ca_state = s_state
    and ss_sold_date_sk = d_date_sk
    and c_customer_sk = ss_customer_sk
    and d_month_seq between {
      from date_dim
      where d_year = 1998 and d_moy = 12
      select distinct d_month_seq + 1
    } and {
      from date_dim
      where d_year = 1998 and d_moy = 12
      select distinct d_month_seq + 3
    }
  group by c_customer_sk
  select c_customer_sk, sum(ss_ext_sales_price) as revenue
}
with segments as {
  from my_revenue
  select round(revenue / 50)::int as SEGMENT
}
from segments
group by SEGMENT
select SEGMENT, count(*) as num_customers, SEGMENT * 50 as segment_base
order by SEGMENT nulls first, num_customers nulls first, segment_base
limit 100
