with wscs as {
  from {
    {
      from web_sales
      select ws_sold_date_sk as sold_date_sk, ws_ext_sales_price as sales_price
      concat
      {
        from catalog_sales
        select 
          cs_sold_date_sk as sold_date_sk,
          cs_ext_sales_price as sales_price
      }
    }
  } as sq1
  select sold_date_sk, sales_price
}
with wswscs as {
  from wscs, date_dim 
  where d_date_sk = sold_date_sk
  group by d_week_seq
  select 
    d_week_seq,
    sum(case  when (d_day_name = 'Sunday') then sales_price  else null)
    as sun_sales,
    sum(case  when (d_day_name = 'Monday') then sales_price  else null)
    as mon_sales,
    sum(case  when (d_day_name = 'Tuesday') then sales_price  else null)
    as tue_sales,
    sum(case  when (d_day_name = 'Wednesday') then sales_price  else null)
    as wed_sales,
    sum(case  when (d_day_name = 'Thursday') then sales_price  else null)
    as thu_sales,
    sum(case  when (d_day_name = 'Friday') then sales_price  else null)
    as fri_sales,
    sum(case  when (d_day_name = 'Saturday') then sales_price  else null)
    as sat_sales
}
from {
  {
    from wswscs, date_dim 
    where date_dim.d_week_seq = wswscs.d_week_seq and d_year = 2001
    select 
      wswscs.d_week_seq as d_week_seq1,
      sun_sales as sun_sales1,
      mon_sales as mon_sales1,
      tue_sales as tue_sales1,
      wed_sales as wed_sales1,
      thu_sales as thu_sales1,
      fri_sales as fri_sales1,
      sat_sales as sat_sales1
  }
} as y, {
  {
    from wswscs, date_dim 
    where date_dim.d_week_seq = wswscs.d_week_seq and d_year = 2001 + 1
    select 
      wswscs.d_week_seq as d_week_seq2,
      sun_sales as sun_sales2,
      mon_sales as mon_sales2,
      tue_sales as tue_sales2,
      wed_sales as wed_sales2,
      thu_sales as thu_sales2,
      fri_sales as fri_sales2,
      sat_sales as sat_sales2
  }
} as z
  
where d_week_seq1 = d_week_seq2 - 53
select 
  d_week_seq1,
  round(sun_sales1 / sun_sales2, 2) as r1,
  round(mon_sales1 / mon_sales2, 2) as r2,
  round(tue_sales1 / tue_sales2, 2) as r3,
  round(wed_sales1 / wed_sales2, 2) as r4,
  round(thu_sales1 / thu_sales2, 2) as r5,
  round(fri_sales1 / fri_sales2, 2) as r6,
  round(sat_sales1 / sat_sales2, 2)
order by d_week_seq1 nulls first
