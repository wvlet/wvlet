with results as {
  from store_sales, customer_demographics , date_dim , store , item 
  where 
    ss_sold_date_sk = d_date_sk
    and ss_item_sk = i_item_sk
    and ss_store_sk = s_store_sk
    and ss_cdemo_sk = cd_demo_sk
    and cd_gender = 'M'
    and cd_marital_status = 'S'
    and cd_education_status = 'College'
    and d_year = 2002
    and s_state = 'TN'
  select 
    i_item_id,
    s_state,
    0 as g_state,
    ss_quantity as agg1,
    ss_list_price as agg2,
    ss_coupon_amt as agg3,
    ss_sales_price as agg4
}
from {
  {
    from results
    group by i_item_id, s_state
    select 
      i_item_id,
      s_state,
      0 as g_state,
      avg(agg1) as agg1,
      avg(agg2) as agg2,
      avg(agg3) as agg3,
      avg(agg4) as agg4
    concat
    {
      from results
      group by i_item_id
      select 
        i_item_id,
        null as s_state,
        1 as g_state,
        avg(agg1) as agg1,
        avg(agg2) as agg2,
        avg(agg3) as agg3,
        avg(agg4) as agg4
      concat
      {
        from results
        select 
          null as i_item_id,
          null as s_state,
          1 as g_state,
          avg(agg1) as agg1,
          avg(agg2) as agg2,
          avg(agg3) as agg3,
          avg(agg4) as agg4
      }
    }
  }
} as foo
select i_item_id, s_state, g_state, agg1, agg2, agg3, agg4
order by i_item_id nulls first, s_state nulls first
limit 100
