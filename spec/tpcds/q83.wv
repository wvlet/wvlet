with sr_items as {
  from store_returns, item , date_dim 
  where 
    sr_item_sk = i_item_sk
    and d_date in (
      {
        from date_dim
        where 
          d_week_seq in (
            {
              from date_dim
              where d_date in ('2000-06-30', '2000-09-27', '2000-11-17')
              select d_week_seq
            }
          )
        select d_date
      }
    )
    and sr_returned_date_sk = d_date_sk
  group by i_item_id
  select i_item_id as item_id, sum(sr_return_quantity) as sr_item_qty
}
with cr_items as {
  from catalog_returns, item , date_dim 
  where 
    cr_item_sk = i_item_sk
    and d_date in (
      {
        from date_dim
        where 
          d_week_seq in (
            {
              from date_dim
              where d_date in ('2000-06-30', '2000-09-27', '2000-11-17')
              select d_week_seq
            }
          )
        select d_date
      }
    )
    and cr_returned_date_sk = d_date_sk
  group by i_item_id
  select i_item_id as item_id, sum(cr_return_quantity) as cr_item_qty
}
with wr_items as {
  from web_returns, item , date_dim 
  where 
    wr_item_sk = i_item_sk
    and d_date in (
      {
        from date_dim
        where 
          d_week_seq in (
            {
              from date_dim
              where d_date in ('2000-06-30', '2000-09-27', '2000-11-17')
              select d_week_seq
            }
          )
        select d_date
      }
    )
    and wr_returned_date_sk = d_date_sk
  group by i_item_id
  select i_item_id as item_id, sum(wr_return_quantity) as wr_item_qty
}
from sr_items, cr_items , wr_items 
where 
  sr_items.item_id = cr_items.item_id
  and sr_items.item_id = wr_items.item_id
select 
  sr_items.item_id,
  sr_item_qty,
  (sr_item_qty * 1.0000) / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0000 * 100
  as sr_dev,
  cr_item_qty,
  (cr_item_qty * 1.0000) / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0000 * 100
  as cr_dev,
  wr_item_qty,
  (wr_item_qty * 1.0000) / (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0000 * 100
  as wr_dev,
  (sr_item_qty + cr_item_qty + wr_item_qty) / 3.0 as average
order by sr_items.item_id nulls first, sr_item_qty nulls first
limit 100
