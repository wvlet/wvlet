{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl; unset the one inherited from @docusaurus/tsconfig and
    // redeclare its paths, which now resolve relative to this file
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
