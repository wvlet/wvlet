package wvlet.standard

trait any = {
  -- @example 42.to_string
  def to_string: string = sql"cast(${this} as varchar)"
  -- @example '42'.to_int
  def to_int: int = sql"cast(${this} as bigint)"
  def to_int in bigquery: int = sql"cast(${this} as int64)"
  def to_long: long = sql"cast(${this} as bigint)"
  def to_long in bigquery: long = sql"cast(${this} as int64)"
  -- @example '1.5'.to_float
  def to_float: float = sql"cast(${this} as double)"
  def to_float in bigquery: float = sql"cast(${this} as float64)"
  def to_double: double = sql"cast(${this} as double)"
  def to_double in bigquery: double = sql"cast(${this} as float64)"
  def to_boolean: boolean = sql"cast(${this} as boolean)"
  def to_boolean in bigquery: boolean = sql"cast(${this} as bool)"

  -- Cast to the SQL date type
  def to_date: date = sql"cast(${this} as date)"
  -- Cast to the SQL timestamp type
  def to_timestamp: timestamp = sql"cast(${this} as timestamp)"

  -- True if this value is null
  -- @example from [[1], [null]] as t(x) select x.is_null
  def is_null: boolean = sql"${this} is null"
  -- @example from [[1], [null]] as t(x) select x.is_not_null
  def is_not_null: boolean = sql"${this} is not null"

  -- Return the other value if this value is null
  -- @example from [[1], [null]] as t(x) select x.or_else(0)
  def or_else(other:any): any = sql"coalesce(${this},${other})"
  -- Return null if this value equals the given value
  -- @example from [[0], [5]] as t(x) select x.null_if(0)
  def null_if(v:any): any = sql"nullif(${this},${v})"

  -- Name of the runtime type of this value
  -- @example 'Wvlet'.type_of
  def type_of: string = sql"typeof(${this})"

  -- TODO Support type args: def to_decimal[P,S]: decimal[P,S]
  -- TODO Support generic type cast: def cast_as[A]: A = sql"cast(${this} as ${type[A]})"
}

trait any in duckdb = {
  def to_json: json = sql"to_json(${this})"
}

trait any in trino = {
  def to_json: json = sql"cast(${this} as json)"
}

trait any in hive = {
  -- Hive rejects `varchar` without a length in casts; its string type is `string`
  def to_string: string = sql"cast(${this} as string)"
}

trait any in bigquery = {
  -- BigQuery's string type is `string`, not `varchar`
  def to_string: string = sql"cast(${this} as string)"
}
