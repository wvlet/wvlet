package wvlet.standard

trait timestamp = {
  def extract(field:string): int = sql"extract(${field} from ${this})"

  def year: int = sql"extract(year from ${this})"
  def month: int = sql"extract(month from ${this})"
  def day: int = sql"extract(day from ${this})"
  def hour: int = sql"extract(hour from ${this})"
  def minute: int = sql"extract(minute from ${this})"
  def second: int = sql"extract(second from ${this})"
  def quarter: int = sql"extract(quarter from ${this})"
  def week: int = sql"extract(week from ${this})"

  def or_else(other:timestamp): timestamp = sql"coalesce(${this},${other})"

  def to_date: date = sql"cast(${this} as date)"

  -- Truncate to the given unit ('year', 'month', 'day', 'hour', 'minute', 'second')
  def truncate_to(unit:string): timestamp = sql"date_trunc(${unit},${this})"

  -- Difference between this and the other timestamp, in the given unit
  def diff_seconds(other:timestamp): long = sql"date_diff('second',${this},${other})"
  def diff_minutes(other:timestamp): long = sql"date_diff('minute',${this},${other})"
  def diff_hours(other:timestamp): long = sql"date_diff('hour',${this},${other})"
  def diff_days(other:timestamp): long = sql"date_diff('day',${this},${other})"

  def between(l:timestamp, r:timestamp): boolean = sql"${this} between ${l} and ${r}"
}

trait timestamp in duckdb = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"extract(isodow from ${this})"
  def day_of_year: int = sql"extract(dayofyear from ${this})"

  def add_seconds(n:int): timestamp = sql"${this} + INTERVAL (${n}) SECOND"
  def add_minutes(n:int): timestamp = sql"${this} + INTERVAL (${n}) MINUTE"
  def add_hours(n:int): timestamp = sql"${this} + INTERVAL (${n}) HOUR"
  def add_days(n:int): timestamp = sql"${this} + INTERVAL (${n}) DAY"
  def add_months(n:int): timestamp = sql"${this} + INTERVAL (${n}) MONTH"
  def add_years(n:int): timestamp = sql"${this} + INTERVAL (${n}) YEAR"

  -- Format the timestamp with a strftime-style pattern (e.g. '%Y-%m-%d %H:%M:%S')
  def format(pattern:string): string = sql"strftime(${this},${pattern})"

  -- Unix epoch seconds of this timestamp, floored to a whole second
  def to_unixtime: long = sql"cast(floor(epoch(${this})) as bigint)"

  -- Render as 'YYYY-MM-DD HH:MM:SS'. Overridden per engine so the rendering is identical
  def to_string: string = sql"cast(${this} as varchar)"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"dayname(${this})"
  def month_name: string = sql"monthname(${this})"
  -- ISO-8601 week-numbering year: the year of the Thursday of this timestamp's ISO week
  def iso_year: int = sql"isoyear(${this})"

  -- This UTC wall-clock time as wall-clock time in the zone (e.g. 'Asia/Tokyo'), and the inverse
  def to_time_zone(zone:string): timestamp = sql"(${this} AT TIME ZONE 'UTC') AT TIME ZONE ${zone}"
  def from_time_zone(zone:string): timestamp = sql"(${this} AT TIME ZONE ${zone}) AT TIME ZONE 'UTC'"
}

trait timestamp in trino = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"day_of_week(${this})"
  def day_of_year: int = sql"day_of_year(${this})"

  def add_seconds(n:int): timestamp = sql"date_add('second',${n},${this})"
  def add_minutes(n:int): timestamp = sql"date_add('minute',${n},${this})"
  def add_hours(n:int): timestamp = sql"date_add('hour',${n},${this})"
  def add_days(n:int): timestamp = sql"date_add('day',${n},${this})"
  def add_months(n:int): timestamp = sql"date_add('month',${n},${this})"
  def add_years(n:int): timestamp = sql"date_add('year',${n},${this})"

  -- Format the timestamp with a MySQL-style pattern (e.g. '%Y-%m-%d %H:%i:%S')
  def format(pattern:string): string = sql"date_format(${this},${pattern})"

  -- Unix epoch seconds of this timestamp. The bare timestamp is interpreted as UTC
  -- regardless of the session time zone, matching DuckDB's epoch() semantics
  def to_unixtime: long = sql"cast(floor(to_unixtime(with_timezone(${this},'UTC'))) as bigint)"

  -- Render without the sub-second part (e.g. '2024-03-15 10:30:45'), matching
  -- DuckDB's default timestamp rendering instead of Trino's trailing '.000'
  def to_string: string = sql"date_format(${this},'%Y-%m-%d %H:%i:%s')"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"date_format(${this},'%W')"
  def month_name: string = sql"date_format(${this},'%M')"
  -- ISO-8601 week-numbering year
  def iso_year: int = sql"year_of_week(${this})"

  -- This UTC wall-clock time as wall-clock time in the zone (e.g. 'Asia/Tokyo'), and the inverse
  def to_time_zone(zone:string): timestamp = sql"cast(with_timezone(${this},'UTC') AT TIME ZONE ${zone} as timestamp(6))"
  def from_time_zone(zone:string): timestamp = sql"cast(with_timezone(${this},${zone}) AT TIME ZONE 'UTC' as timestamp(6))"
}

trait timestamp in hive = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"pmod(dayofweek(${this}) + 5, 7) + 1"
  def day_of_year: int = sql"cast(date_format(${this},'D') as int)"

  -- Timestamp arithmetic via unix epoch seconds (Hive has no timestamp interval functions)
  def add_seconds(n:int): timestamp = sql"cast(from_unixtime(unix_timestamp(${this}) + ${n}) as timestamp)"
  def add_minutes(n:int): timestamp = sql"cast(from_unixtime(unix_timestamp(${this}) + ${n} * 60) as timestamp)"
  def add_hours(n:int): timestamp = sql"cast(from_unixtime(unix_timestamp(${this}) + ${n} * 3600) as timestamp)"
  def add_days(n:int): timestamp = sql"cast(from_unixtime(unix_timestamp(${this}) + ${n} * 86400) as timestamp)"

  -- Format the timestamp with a Java SimpleDateFormat pattern (e.g. 'yyyy-MM-dd HH:mm:ss')
  def format(pattern:string): string = sql"date_format(${this},${pattern})"

  -- Unix epoch seconds of this timestamp, evaluated in the session time zone
  def to_unixtime: long = sql"cast(unix_timestamp(${this}) as bigint)"

  def to_string: string = sql"cast(${this} as string)"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"date_format(${this},'EEEE')"
  def month_name: string = sql"date_format(${this},'MMMM')"

  -- This UTC wall-clock time as wall-clock time in the zone (e.g. 'Asia/Tokyo'), and the inverse
  def to_time_zone(zone:string): timestamp = sql"from_utc_timestamp(${this},${zone})"
  def from_time_zone(zone:string): timestamp = sql"to_utc_timestamp(${this},${zone})"
}

trait timestamp in snowflake = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"dayofweekiso(${this})"
  def day_of_year: int = sql"dayofyear(${this})"

  def add_seconds(n:int): timestamp = sql"dateadd('second',${n},${this})"
  def add_minutes(n:int): timestamp = sql"dateadd('minute',${n},${this})"
  def add_hours(n:int): timestamp = sql"dateadd('hour',${n},${this})"
  def add_days(n:int): timestamp = sql"dateadd('day',${n},${this})"
  def add_months(n:int): timestamp = sql"dateadd('month',${n},${this})"
  def add_years(n:int): timestamp = sql"dateadd('year',${n},${this})"

  -- Format the timestamp with a SQL format model (e.g. 'YYYY-MM-DD HH24:MI:SS')
  def format(pattern:string): string = sql"to_char(${this},${pattern})"

  def diff_seconds(other:timestamp): long = sql"datediff('second',${this},${other})"
  def diff_minutes(other:timestamp): long = sql"datediff('minute',${this},${other})"
  def diff_hours(other:timestamp): long = sql"datediff('hour',${this},${other})"
  def diff_days(other:timestamp): long = sql"datediff('day',${this},${other})"

  -- Unix epoch seconds of this timestamp
  def to_unixtime: long = sql"cast(date_part('epoch_second',${this}) as bigint)"

  -- Render without the sub-second part, matching the other engines
  def to_string: string = sql"to_char(${this},'YYYY-MM-DD HH24:MI:SS')"

  -- ISO-8601 week-numbering year
  def iso_year: int = sql"yearofweekiso(${this})"

  -- This UTC wall-clock time as wall-clock time in the zone (e.g. 'Asia/Tokyo'), and the inverse
  def to_time_zone(zone:string): timestamp = sql"convert_timezone('UTC',${zone},${this})"
  def from_time_zone(zone:string): timestamp = sql"convert_timezone(${zone},'UTC',${this})"
}

trait timestamp in bigquery = {
  -- ISO day of week (1 = Monday, 7 = Sunday; BigQuery's DAYOFWEEK starts at 1 = Sunday)
  def day_of_week: int = sql"mod(extract(dayofweek from ${this}) + 5, 7) + 1"
  def day_of_year: int = sql"extract(dayofyear from ${this})"

  def add_seconds(n:int): timestamp = sql"timestamp_add(${this}, interval (${n}) second)"
  def add_minutes(n:int): timestamp = sql"timestamp_add(${this}, interval (${n}) minute)"
  def add_hours(n:int): timestamp = sql"timestamp_add(${this}, interval (${n}) hour)"
  def add_days(n:int): timestamp = sql"timestamp_add(${this}, interval (${n}) day)"

  -- Format the timestamp with a strftime-style pattern (e.g. '%Y-%m-%d %H:%M:%S')
  def format(pattern:string): string = sql"format_timestamp(${pattern},${this})"

  def diff_seconds(other:timestamp): long = sql"timestamp_diff(${other},${this},second)"
  def diff_minutes(other:timestamp): long = sql"timestamp_diff(${other},${this},minute)"
  def diff_hours(other:timestamp): long = sql"timestamp_diff(${other},${this},hour)"
  def diff_days(other:timestamp): long = sql"timestamp_diff(${other},${this},day)"

  -- Unix epoch seconds of this timestamp
  def to_unixtime: long = sql"unix_seconds(${this})"

  -- Render without the sub-second part, matching the other engines
  def to_string: string = sql"format_timestamp('%Y-%m-%d %H:%M:%S',${this})"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"format_timestamp('%A',${this})"
  def month_name: string = sql"format_timestamp('%B',${this})"
  -- ISO-8601 week-numbering year
  def iso_year: int = sql"extract(isoyear from ${this})"

  -- This UTC wall-clock time as wall-clock time in the zone (e.g. 'Asia/Tokyo'), and the inverse
  def to_time_zone(zone:string): timestamp = sql"timestamp(datetime(${this},${zone}))"
  def from_time_zone(zone:string): timestamp = sql"timestamp(datetime(${this}),${zone})"
}

-- current_date / current_timestamp: today's date and the current time, in UTC (stdlib timestamps
-- are UTC wall-clock times). Written without parentheses
def current_date in duckdb: date = sql"cast(now() AT TIME ZONE 'UTC' as date)"
def current_date in trino: date = sql"cast(current_timestamp AT TIME ZONE 'UTC' as date)"
def current_date in snowflake: date = sql"cast(sysdate() as date)"
def current_date in bigquery: date = sql"current_date('UTC')"
def current_timestamp in duckdb: timestamp = sql"now() AT TIME ZONE 'UTC'"
def current_timestamp in trino: timestamp = sql"cast(current_timestamp AT TIME ZONE 'UTC' as timestamp(6))"
def current_timestamp in snowflake: timestamp = sql"sysdate()"
def current_timestamp in bigquery: timestamp = sql"current_timestamp()"
