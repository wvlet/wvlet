package wvlet.standard

-- Functions of json values. The same functions are also available on strings holding JSON
-- text (see string.wv)
type json = {
  -- Extract the JSON value at the JSONPath expression (e.g. '$.store.book')
  def json_extract(path:string): json = sql"json_extract(${this},${path})"

  -- Extract the value at the JSONPath expression as a plain string
  def json_extract_string(path:string) in duckdb: string = sql"json_extract_string(${this},${path})"
  def json_extract_string(path:string) in trino: string = sql"json_extract_scalar(${this},${path})"
}
