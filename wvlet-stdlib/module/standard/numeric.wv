package wvlet.standard

-- Functions shared by all numeric types (int, long, float, real, double, decimal).
-- Member lookup on a numeric value falls back to this type when the value's own type
-- does not define the member, so common math functions need only one definition here.
-- Functions whose return type follows the value's own type (abs, ceil, floor, mod,
-- truncate, or_else, between) stay defined per type.
trait numeric = {
  -- Round to the given number of decimal places
  def round(decimal:int=0): double = sql"round(${this},${decimal})"

  def sqrt: double = sql"sqrt(${this})"
  def cbrt: double = sql"cbrt(${this})"
  def exp: double = sql"exp(${this})"
  def ln: double = sql"ln(${this})"
  def log10: double = sql"log10(${this})"
  def log10 in snowflake: double = sql"log(10,${this})"
  def log2: double = sql"log2(${this})"
  def log2 in snowflake: double = sql"log(2,${this})"
  def log2 in bigquery: double = sql"log(${this}, 2)"
  def power(exponent:double): double = sql"power(${this},${exponent})"
  def sign: int = sql"sign(${this})"

  -- Interpret this value as unix epoch seconds (in UTC), keeping the fraction to the microsecond
  def from_unixtime in duckdb: timestamp = sql"make_timestamp(cast(${this} * 1000000 as bigint))"
  def from_unixtime in trino: timestamp = sql"cast(from_unixtime(${this}) AT TIME ZONE 'UTC' as timestamp(6))"
  def from_unixtime in snowflake: timestamp = sql"to_timestamp_ntz(${this})"
  def from_unixtime in bigquery: timestamp = sql"timestamp_micros(cast(${this} * 1000000 as int64))"

  -- Hyperbolic sine, cosine, and tangent
  def sinh: double = sql"sinh(${this})"
  def sinh in hive: double = sql"((exp(cast(${this} as double)) - exp(-cast(${this} as double))) / 2)"
  def cosh: double = sql"cosh(${this})"
  def cosh in hive: double = sql"((exp(cast(${this} as double)) + exp(-cast(${this} as double))) / 2)"
  def tanh: double = sql"tanh(${this})"
  def tanh in hive: double = sql"(1 - 2 / (exp(2 * cast(${this} as double)) + 1))"
  -- Inverse hyperbolic sine, cosine (NaN below 1), and tangent (NaN outside -1..1, infinite at -1 and 1)
  def asinh: double = sql"asinh(${this})"
  def asinh in trino: double = sql"(sign(cast(${this} as double)) * ln(abs(cast(${this} as double)) + sqrt(cast(${this} as double) * cast(${this} as double) + 1)))"
  def asinh in hive: double = sql"(sign(cast(${this} as double)) * ln(abs(cast(${this} as double)) + sqrt(cast(${this} as double) * cast(${this} as double) + 1)))"
  def acosh in duckdb: double = sql"acosh(${this})"
  def acosh in trino: double = sql"ln(cast(${this} as double) + sqrt(cast(${this} as double) - 1) * sqrt(cast(${this} as double) + 1))"
  def acosh in snowflake: double = sql"acosh(${this})"
  def acosh in bigquery: double = sql"acosh(${this})"
  def atanh in duckdb: double = sql"atanh(${this})"
  def atanh in trino: double = sql"(0.5 * ln((1 + cast(${this} as double)) / (1 - cast(${this} as double))))"
  def atanh in snowflake: double = sql"atanh(${this})"
  def atanh in bigquery: double = sql"atanh(${this})"
  -- Cotangent (1 / tan)
  def cot: double = sql"cot(${this})"
  def cot in trino: double = sql"(1 / tan(${this}))"
  def cot in hive: double = sql"(1 / tan(${this}))"

  -- Round to an integer, or to the given number of decimal places, rounding ties to the even neighbor (banker's rounding)
  def round_half_even in duckdb: double = sql"round_even(${this},0)"
  def round_half_even in hive: double = sql"bround(${this},0)"
  def round_half_even(decimal:int) in duckdb: double = sql"round_even(${this},${decimal})"
  def round_half_even(decimal:int) in hive: double = sql"bround(${this},${decimal})"

  def in(v:any*): boolean = sql"${this} in (${v})"
  def not_in(v:any*): boolean = sql"${this} not in (${v})"
}
