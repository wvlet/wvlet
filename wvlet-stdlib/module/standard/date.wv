package wvlet.standard

type date = {
  def extract(field:string): int = sql"extract(${field} from ${this})"

  def year: int = sql"extract(year from ${this})"
  def month: int = sql"extract(month from ${this})"
  def day: int = sql"extract(day from ${this})"
  def quarter: int = sql"extract(quarter from ${this})"
  def week: int = sql"extract(week from ${this})"

  def or_else(other:date): date = sql"coalesce(${this},${other})"

  -- Truncate to the given unit ('year', 'quarter', 'month', 'week', 'day')
  def truncate_to(unit:string): date = sql"cast(date_trunc(${unit},${this}) as date)"

  -- Difference between this and the other date, in the given unit
  def diff_days(other:date): long = sql"date_diff('day',${this},${other})"
  def diff_months(other:date): long = sql"date_diff('month',${this},${other})"
  def diff_years(other:date): long = sql"date_diff('year',${this},${other})"

  def between(l:date, r:date): boolean = sql"${this} between ${l} and ${r}"
}

type date in duckdb = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"extract(isodow from ${this})"
  def day_of_year: int = sql"extract(dayofyear from ${this})"

  def add_days(n:int): date = sql"cast(${this} + INTERVAL (${n}) DAY as date)"
  def add_months(n:int): date = sql"cast(${this} + INTERVAL (${n}) MONTH as date)"
  def add_years(n:int): date = sql"cast(${this} + INTERVAL (${n}) YEAR as date)"

  -- Format the date with a strftime-style pattern (e.g. '%Y-%m-%d')
  def format(pattern:string): string = sql"strftime(${this},${pattern})"

  -- The last day of the month of this date
  def last_day: date = sql"last_day(${this})"
}

type date in trino = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"day_of_week(${this})"
  def day_of_year: int = sql"day_of_year(${this})"

  def add_days(n:int): date = sql"date_add('day',${n},${this})"
  def add_months(n:int): date = sql"date_add('month',${n},${this})"
  def add_years(n:int): date = sql"date_add('year',${n},${this})"

  -- Format the date with a MySQL-style pattern (e.g. '%Y-%m-%d')
  def format(pattern:string): string = sql"date_format(cast(${this} as timestamp),${pattern})"

  -- The last day of the month of this date
  def last_day: date = sql"last_day_of_month(${this})"
}
