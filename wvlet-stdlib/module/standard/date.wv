package wvlet.standard

trait date = {
  -- @example '2024-03-15'.to_date.extract('dow')
  def extract(field:string): int = sql"extract(${field} from ${this})"

  -- @example '2024-03-15'.to_date.year
  def year: int = sql"extract(year from ${this})"
  -- @example '2024-03-15'.to_date.month
  def month: int = sql"extract(month from ${this})"
  -- @example '2024-03-15'.to_date.day
  def day: int = sql"extract(day from ${this})"
  -- @example '2024-03-15'.to_date.quarter
  def quarter: int = sql"extract(quarter from ${this})"
  -- @example '2024-03-15'.to_date.week
  def week: int = sql"extract(week from ${this})"

  def or_else(other:date): date = sql"coalesce(${this},${other})"

  -- Truncate to the given unit ('year', 'quarter', 'month', 'week', 'day')
  -- @example '2024-03-15'.to_date.truncate_to('month')
  def truncate_to(unit:string): date = sql"cast(date_trunc(${unit},${this}) as date)"

  -- Difference between this and the other date, in the given unit
  -- @example '2024-03-15'.to_date.diff_days('2024-03-25'.to_date)
  def diff_days(other:date): long = sql"date_diff('day',${this},${other})"
  -- @example '2024-03-15'.to_date.diff_months('2024-06-15'.to_date)
  def diff_months(other:date): long = sql"date_diff('month',${this},${other})"
  -- @example '2020-03-15'.to_date.diff_years('2024-03-15'.to_date)
  def diff_years(other:date): long = sql"date_diff('year',${this},${other})"

  -- @example '2024-03-15'.to_date.between('2024-01-01'.to_date, '2024-12-31'.to_date)
  def between(l:date, r:date): boolean = sql"${this} between ${l} and ${r}"
}

trait date in duckdb = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  -- @example '2024-03-15'.to_date.day_of_week
  def day_of_week: int = sql"extract(isodow from ${this})"
  -- @example '2024-03-15'.to_date.day_of_year
  def day_of_year: int = sql"extract(dayofyear from ${this})"

  -- @example '2024-03-15'.to_date.add_days(20)
  def add_days(n:int): date = sql"cast(${this} + INTERVAL (${n}) DAY as date)"
  -- @example '2024-01-31'.to_date.add_months(1)
  def add_months(n:int): date = sql"cast(${this} + INTERVAL (${n}) MONTH as date)"
  -- @example '2024-02-29'.to_date.add_years(1)
  def add_years(n:int): date = sql"cast(${this} + INTERVAL (${n}) YEAR as date)"

  -- Format the date with a strftime-style pattern (e.g. '%Y-%m-%d')
  -- @example '2024-03-15'.to_date.format('%Y/%m/%d')
  def format(pattern:string): string = sql"strftime(${this},${pattern})"

  -- The last day of the month of this date
  -- @example '2024-02-10'.to_date.last_day
  def last_day: date = sql"last_day(${this})"

  -- Full English day and month names ('Monday', 'January')
  -- @example '2024-03-15'.to_date.day_name
  def day_name: string = sql"dayname(${this})"
  -- @example '2024-03-15'.to_date.month_name
  def month_name: string = sql"monthname(${this})"
  -- ISO-8601 week-numbering year: the year of the Thursday of this date's ISO week
  -- @example '2024-12-30'.to_date.iso_year
  def iso_year: int = sql"isoyear(${this})"
}

trait date in trino = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"day_of_week(${this})"
  def day_of_year: int = sql"day_of_year(${this})"

  def add_days(n:int): date = sql"date_add('day',${n},${this})"
  def add_months(n:int): date = sql"date_add('month',${n},${this})"
  def add_years(n:int): date = sql"date_add('year',${n},${this})"

  -- Format the date with a MySQL-style pattern (e.g. '%Y-%m-%d')
  def format(pattern:string): string = sql"date_format(cast(${this} as timestamp),${pattern})"

  -- The last day of the month of this date
  def last_day: date = sql"last_day_of_month(${this})"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"date_format(cast(${this} as timestamp),'%W')"
  def month_name: string = sql"date_format(cast(${this} as timestamp),'%M')"
  -- ISO-8601 week-numbering year
  def iso_year: int = sql"year_of_week(${this})"
}

trait date in hive = {
  def week: int = sql"weekofyear(${this})"
  def quarter: int = sql"quarter(${this})"

  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"pmod(dayofweek(${this}) + 5, 7) + 1"
  def day_of_year: int = sql"cast(date_format(${this},'D') as int)"

  -- Truncate with Hive's trunc() unit tokens ('YYYY', 'MM', 'Q')
  def truncate_to(unit:string): date = sql"cast(trunc(${this},${unit}) as date)"

  def add_days(n:int): date = sql"date_add(${this},${n})"
  def add_months(n:int): date = sql"cast(add_months(${this},${n}) as date)"
  def add_years(n:int): date = sql"cast(add_months(${this},${n} * 12) as date)"

  def diff_days(other:date): long = sql"cast(datediff(${other},${this}) as bigint)"
  def diff_months(other:date): long = sql"cast(months_between(${other},${this}) as bigint)"
  def diff_years(other:date): long = sql"cast(months_between(${other},${this}) / 12 as bigint)"

  -- Format the date with a Java SimpleDateFormat pattern (e.g. 'yyyy-MM-dd')
  def format(pattern:string): string = sql"date_format(${this},${pattern})"

  -- The last day of the month of this date
  def last_day: date = sql"cast(last_day(${this}) as date)"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"date_format(${this},'EEEE')"
  def month_name: string = sql"date_format(${this},'MMMM')"
}

trait date in snowflake = {
  -- ISO day of week (1 = Monday, 7 = Sunday) and day of year
  def day_of_week: int = sql"dayofweekiso(${this})"
  def day_of_year: int = sql"dayofyear(${this})"

  def add_days(n:int): date = sql"dateadd('day',${n},${this})"
  def add_months(n:int): date = sql"dateadd('month',${n},${this})"
  def add_years(n:int): date = sql"dateadd('year',${n},${this})"

  def diff_days(other:date): long = sql"datediff('day',${this},${other})"
  def diff_months(other:date): long = sql"datediff('month',${this},${other})"
  def diff_years(other:date): long = sql"datediff('year',${this},${other})"

  -- Format the date with a SQL format model (e.g. 'YYYY-MM-DD')
  def format(pattern:string): string = sql"to_char(${this},${pattern})"

  -- The last day of the month of this date
  def last_day: date = sql"last_day(${this})"

  -- ISO-8601 week-numbering year
  def iso_year: int = sql"yearofweekiso(${this})"
}

trait date in bigquery = {
  -- ISO day of week (1 = Monday, 7 = Sunday; BigQuery's DAYOFWEEK starts at 1 = Sunday)
  def day_of_week: int = sql"mod(extract(dayofweek from ${this}) + 5, 7) + 1"
  def day_of_year: int = sql"extract(dayofyear from ${this})"

  def add_days(n:int): date = sql"date_add(${this}, interval (${n}) day)"
  def add_months(n:int): date = sql"date_add(${this}, interval (${n}) month)"
  def add_years(n:int): date = sql"date_add(${this}, interval (${n}) year)"

  def diff_days(other:date): long = sql"date_diff(${other},${this},day)"
  def diff_months(other:date): long = sql"date_diff(${other},${this},month)"
  def diff_years(other:date): long = sql"date_diff(${other},${this},year)"

  -- Format the date with a strftime-style pattern (e.g. '%Y-%m-%d')
  def format(pattern:string): string = sql"format_date(${pattern},${this})"

  -- The last day of the month of this date
  def last_day: date = sql"last_day(${this})"

  -- Full English day and month names ('Monday', 'January')
  def day_name: string = sql"format_date('%A',${this})"
  def month_name: string = sql"format_date('%B',${this})"
  -- ISO-8601 week-numbering year
  def iso_year: int = sql"extract(isoyear from ${this})"
}
