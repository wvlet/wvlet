-- AsOf join
-- Join each row with the latest row of the other side at or before its time.
val holding(symbol, date, shares) = [
  ['AAPL', '2024-11-07', 1.0],
  ['AAPL', '2024-11-08', 2.0],
  ['AAPL', '2024-11-09', 3.0],
  ['AAPL', '2024-11-10', 4.0]
]
val stock(symbol, date, price) = [
  ['AAPL', '2024-11-07', 10],
  ['AAPL', '2024-11-08', 50],
  ['AAPL', '2024-11-09', 100]
]

from holding
asof join stock
  on stock.symbol = holding.symbol
  and stock.date <= holding.date
add stock.price * holding.shares as holding_value
select holding.symbol, holding.date, shares, price, holding_value
order by holding.date
